<Window x:Class="CNCStudio.Desktop.MachineSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Maskininställningar" Width="1180" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#17212C" Foreground="#E8F1FA">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="14,6"/><Setter Property="Background" Value="#34475A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#506783"/></Style>
    <Style TargetType="TextBox"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="5"/><Setter Property="Foreground" Value="#152332"/><Setter Property="Background" Value="#F5F8FB"/></Style>
    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="3,3,10,3"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E8F1FA"/><Setter Property="Margin" Value="3,6"/></Style>
    <Style TargetType="GroupBox"><Setter Property="Foreground" Value="#A5C0D9"/><Setter Property="BorderBrush" Value="#50657D"/><Setter Property="Margin" Value="0,6"/><Setter Property="Padding" Value="8,6"/></Style>
  </Window.Resources>
  <Grid Margin="14">
  <Grid.ColumnDefinitions><ColumnDefinition Width="540"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>

  <!-- Right: the controller's own settings memory ($$) -->
  <GroupBox Grid.Column="2" Header="GRBL-KONTROLLERNS INSTÄLLNINGSMINNE ($$)" Margin="0">
    <DockPanel>
      <TextBlock DockPanel.Dock="Top" x:Name="GrblInfoText" TextWrapping="Wrap" FontSize="11.5" Foreground="#BDCEE0" Margin="3,0,3,6"/>
      <WrapPanel DockPanel.Dock="Top">
        <Button x:Name="ReadGrblButton" Content="Läs från maskinen" Click="ReadGrbl_Click" Background="#24618C"/>
        <Button x:Name="WriteGrblButton" Content="Skriv ändrade till maskinen…" Click="WriteGrbl_Click" Background="#8A5A1E" IsEnabled="False"/>
        <Button x:Name="ApplyGrblButton" Content="Använd i profilen ←" Click="ApplyGrbl_Click" IsEnabled="False" ToolTip="Fyll i maskinprofilen till vänster med värdena från maskinen"/>
      </WrapPanel>
      <TextBlock DockPanel.Dock="Bottom" x:Name="GrblResultText" TextWrapping="Wrap" FontSize="11.5" Margin="3,6,3,0"/>
      <DataGrid x:Name="GrblGrid" Height="560" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                CanUserSortColumns="False" HeadersVisibility="Column" Margin="3,6,3,0" FontSize="12"
                Background="#F5F8FB" RowBackground="#F5F8FB" AlternatingRowBackground="#E7EEF5" Foreground="#152332"
                CellEditEnding="GrblGrid_CellEditEnding">
        <DataGrid.Columns>
          <DataGridTextColumn Header="$" Binding="{Binding Code}" IsReadOnly="True" Width="50"/>
          <DataGridTextColumn Header="Inställning" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
          <DataGridTextColumn Header="Enhet" Binding="{Binding Unit}" IsReadOnly="True" Width="64"/>
          <DataGridTextColumn Header="I maskinen" Binding="{Binding MachineValue}" IsReadOnly="True" Width="84"/>
          <DataGridTextColumn Header="Nytt värde" Binding="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}" Width="84"/>
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
  </GroupBox>

  <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" MaxHeight="820">
  <StackPanel>
    <TextBlock Text="Maskinprofilen är det CNC Studio räknar med. Läs maskinens värden till höger och jämför, eller använd dem direkt i profilen." TextWrapping="Wrap" Foreground="#FFD39F" Margin="3,0,3,6"/>

    <GroupBox Header="MASKIN">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock Text="Namn"/><TextBox x:Name="NameBox" Grid.Column="1"/>
      </Grid>
    </GroupBox>

    <GroupBox Header="ARBETSOMRÅDE (BRYTARE TILL BRYTARE)">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock Text="X-rörelse, mm ($130)"/><TextBox x:Name="XBox" Grid.Column="1"/>
        <TextBlock Grid.Row="1" Text="Y-rörelse, mm ($131)"/><TextBox x:Name="YBox" Grid.Row="1" Grid.Column="1"/>
        <TextBlock Grid.Row="2" Text="Z-rörelse, mm ($132)"/><TextBox x:Name="ZBox" Grid.Row="2" Grid.Column="1" ToolTip="Från Z-brytaren upptill och nedåt. Används för att kontrollera att fräsen når det planerade djupet."/>
      </Grid>
    </GroupBox>

    <GroupBox Header="AXELRIKTNING ($3)">
      <StackPanel>
        <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="#BDCEE0" Margin="3,0,3,4"
                   Text="Testa varje axel med knapparna. Rätt är: X+ åt höger, Y+ bort från dig (bakåt), Z+ uppåt. Kryssa i de axlar som går åt fel håll och skriv $3 till maskinen. Gör detta FÖRE homing – testet kräver ingen homing."/>
        <Grid Margin="0,2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="56"/><ColumnDefinition Width="56"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
          <CheckBox x:Name="InvertXBox" Content="Invertera X" Checked="Mask_Changed" Unchecked="Mask_Changed"/>
          <Button Grid.Column="1" Content="X−" Tag="X-" Click="TestAxis_Click" Padding="6,3" ToolTip="Flytta X åt minus (ska gå åt vänster)"/>
          <Button Grid.Column="2" Content="X+" Tag="X+" Click="TestAxis_Click" Padding="6,3" ToolTip="Flytta X åt plus (ska gå åt höger)"/>
          <TextBlock Grid.Column="3" Text="X+ = åt höger" Foreground="#8CA3BA" FontSize="11"/>
          <CheckBox x:Name="InvertYBox" Grid.Row="1" Content="Invertera Y" Checked="Mask_Changed" Unchecked="Mask_Changed"/>
          <Button Grid.Row="1" Grid.Column="1" Content="Y−" Tag="Y-" Click="TestAxis_Click" Padding="6,3" ToolTip="Flytta Y åt minus (ska gå mot dig)"/>
          <Button Grid.Row="1" Grid.Column="2" Content="Y+" Tag="Y+" Click="TestAxis_Click" Padding="6,3" ToolTip="Flytta Y åt plus (ska gå bort från dig)"/>
          <TextBlock Grid.Row="1" Grid.Column="3" Text="Y+ = bort från dig (bakåt)" Foreground="#8CA3BA" FontSize="11"/>
          <CheckBox x:Name="InvertZBox" Grid.Row="2" Content="Invertera Z" Checked="Mask_Changed" Unchecked="Mask_Changed"/>
          <Button Grid.Row="2" Grid.Column="1" Content="Z−" Tag="Z-" Click="TestAxis_Click" Padding="6,3" ToolTip="Flytta Z åt minus (ska gå nedåt)"/>
          <Button Grid.Row="2" Grid.Column="2" Content="Z+" Tag="Z+" Click="TestAxis_Click" Padding="6,3" ToolTip="Flytta Z åt plus (ska gå uppåt)"/>
          <TextBlock Grid.Row="2" Grid.Column="3" Text="Z+ = uppåt" Foreground="#8CA3BA" FontSize="11"/>
          <StackPanel Grid.Row="3" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="Testavstånd (mm)"/>
            <TextBox x:Name="TestDistanceBox" Text="10" Width="64" ToolTip="Hur långt axeln flyttas vid testet. Börja kort."/>
            <TextBlock Text="Hastighet XY 1000, Z 300 mm/min" Foreground="#8CA3BA" FontSize="11" Margin="10,3,3,3"/>
          </StackPanel>
        </Grid>
        <TextBlock x:Name="AxisTestText" TextWrapping="Wrap" FontSize="11.5" Foreground="#FFD39F" Margin="3,2,3,4"/>
        <TextBlock x:Name="DirInvertText" TextWrapping="Wrap" FontSize="11" Foreground="#9FD8A8" Margin="3,0,3,2"/>
      </StackPanel>
    </GroupBox>

    <GroupBox Header="HOMING OCH GRÄNSLÄGESBRYTARE">
      <StackPanel>
        <CheckBox x:Name="HomeOnStartupBox" Content="Maskinen homas alltid vid start ($H)" ToolTip="Homing körs med $H efter varje start. Kräver att homing är aktiverat i GRBL ($22 = 1); då startar GRBL i larmläge tills $H har körts. Krävs för att maskinkoordinaterna och Z-brytarens läge ska vara kända."/>
        <TextBlock Text="Kräver $22 = 1 i GRBL. Lås aldrig upp med $X i stället för att homa – då är maskinkoordinaterna okända." TextWrapping="Wrap" FontSize="11" Foreground="#BDCEE0" Margin="22,0,3,4"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
          <TextBlock Text="Hörn där X/Y-brytarna sitter&#x0a;= bordets nollpunkt ($23)" TextWrapping="Wrap" VerticalAlignment="Top"/>
          <StackPanel Grid.Column="1">
            <StackPanel Orientation="Horizontal">
              <!-- The machine table seen from above: top = back, bottom = front (where you stand). -->
              <Grid Width="170" Height="112" Margin="3,4,10,4">
                <Border Margin="11" Background="#1B2734" BorderBrush="#5D7A96" BorderThickness="1.5">
                  <Grid>
                    <TextBlock Text="BAK" FontSize="9.5" Foreground="#8CA3BA" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3,0,0"/>
                    <TextBlock Text="FRAM (du)" FontSize="9.5" Foreground="#8CA3BA" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                  </Grid>
                </Border>
                <Button x:Name="CornerBL" Tag="BL" Click="Corner_Click" Width="22" Height="22" Padding="0" Margin="0" HorizontalAlignment="Left" VerticalAlignment="Top" ToolTip="Bak vänster (NV)"/>
                <Button x:Name="CornerBR" Tag="BR" Click="Corner_Click" Width="22" Height="22" Padding="0" Margin="0" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Bak höger (NO)"/>
                <Button x:Name="CornerFL" Tag="FL" Click="Corner_Click" Width="22" Height="22" Padding="0" Margin="0" HorizontalAlignment="Left" VerticalAlignment="Bottom" ToolTip="Fram vänster (SV)"/>
                <Button x:Name="CornerFR" Tag="FR" Click="Corner_Click" Width="22" Height="22" Padding="0" Margin="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" ToolTip="Fram höger (SO)"/>
              </Grid>
              <TextBlock Text="Klicka i hörnet där brytarna sitter. Materialets position på bordet räknas därifrån." TextWrapping="Wrap" Width="150" FontSize="11" Foreground="#BDCEE0"/>
            </StackPanel>
            <CheckBox x:Name="HomeXNegBox" Visibility="Collapsed" Checked="Mask_Changed" Unchecked="Mask_Changed"/>
            <CheckBox x:Name="HomeYNegBox" Visibility="Collapsed" Checked="Mask_Changed" Unchecked="Mask_Changed"/>
            <TextBlock x:Name="DirMaskText" TextWrapping="Wrap" FontSize="11" Foreground="#9FD8A8"/>
          </StackPanel>
          <TextBlock Grid.Row="1" Text="Z-brytare"/>
          <TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" FontSize="11.5" Foreground="#9FD8A8"
                     Text="Upptill. Brytaren = MPos Z 0; efter $H står Z på −$27 (pull-off). Tillåtet område: −$132 till 0."/>
          <TextBlock Grid.Row="2" Text="Pull-off efter homing, mm ($27)"/><TextBox x:Name="PullOffBox" Grid.Row="2" Grid.Column="1"/>
        </Grid>
        <CheckBox x:Name="SoftLimitsBox" Content="Mjuka gränser aktiverade i GRBL ($20 = 1)"/>
      </StackPanel>
    </GroupBox>

    <GroupBox Header="SPINDEL / FRÄS">
      <StackPanel>
        <RadioButton x:Name="SpindleManualBox" GroupName="Spindle" Foreground="#E8F1FA" Margin="3,4"
                     Content="Manuell – fräsen startas och varvtalet ställs för hand"/>
        <TextBlock Text="G-coden skriver inga M3/S/M5. Programmet pausar (M0) så att du kan starta fräsen och ställa varvtalet; fortsätt med ~ (Fortsätt)." TextWrapping="Wrap" FontSize="11" Foreground="#BDCEE0" Margin="22,0,3,6"/>
        <RadioButton x:Name="SpindleGrblBox" GroupName="Spindle" Foreground="#E8F1FA" Margin="3,4"
                     Content="Styrs av GRBL (M3 S… / M5)"/>
        <TextBlock Text="GRBL slår på spindeln med M3 och varvtal S (skalas mot $30/$31) och väntar uppstartstiden (G4)." TextWrapping="Wrap" FontSize="11" Foreground="#BDCEE0" Margin="22,0,3,4"/>
      </StackPanel>
    </GroupBox>

    <GroupBox Header="SÄKERHET">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock Text="Marginal till gränslägen, mm" TextWrapping="Wrap"/><TextBox x:Name="MarginBox" Grid.Column="1" ToolTip="Planerade rörelser håller minst detta avstånd till alla gränslägen: XY-kanterna samt Z upptill och nedtill."/>
      </Grid>
    </GroupBox>

    <TextBlock x:Name="WarningText" TextWrapping="Wrap" Foreground="#FF9C8F" Margin="3,6"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
      <Button Content="Spara" Background="#24618C" IsDefault="True" Click="Save_Click"/>
      <Button Content="Avbryt" IsCancel="True"/>
    </StackPanel>
  </StackPanel>
  </ScrollViewer>
  </Grid>
</Window>
