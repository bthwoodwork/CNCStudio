<Window x:Class="CNCStudio.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="CNC Studio 0.5.10 – GRBL-anslutning" Width="1500" Height="930" MinWidth="1060" MinHeight="650"
 KeyDown="Window_KeyDown" Loaded="Window_Loaded" Closing="MainWindow_Closing"
 Background="#17212C" Foreground="#E8F1FA">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="8,6"/><Setter Property="Background" Value="#34475A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#506783"/></Style>
  <Style TargetType="TextBox"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="5"/><Setter Property="Foreground" Value="#152332"/><Setter Property="Background" Value="#F5F8FB"/></Style>
  <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style TargetType="MenuItem"><Setter Property="Foreground" Value="#E8F1FA"/><Setter Property="Background" Value="#26384D"/></Style>
 </Window.Resources>
 <DockPanel>
 
<Menu DockPanel.Dock="Top" Background="#26384D" Foreground="#F4F7FB" Padding="5,3" FontSize="13">
 <MenuItem Header="_Arkiv"><MenuItem Header="Nytt" Click="New_Click" InputGestureText="Ctrl+N"/><MenuItem Header="Öppna..." Click="Open_Click" InputGestureText="Ctrl+O"/><Separator/><MenuItem Header="Spara" Click="Save_Click" InputGestureText="Ctrl+S"/><MenuItem Header="Spara som..." Click="SaveAs_Click" InputGestureText="Ctrl+Shift+S"/><Separator/><MenuItem Header="Importera SVG / DXF..." Click="ImportVector_Click" InputGestureText="Ctrl+I"/><Separator/><MenuItem Header="Avsluta" Click="Exit_Click"/></MenuItem>
 <MenuItem Header="_Redigera"><MenuItem Header="Ångra" Click="Undo_Click" InputGestureText="Ctrl+Z"/><MenuItem Header="Gör om" Click="Redo_Click" InputGestureText="Ctrl+Y"/><Separator/><MenuItem Header="Markera alla" Click="SelectAll_Click" InputGestureText="Ctrl+A"/><MenuItem Header="Gruppera" Click="Group_Click" InputGestureText="Ctrl+G"/><MenuItem Header="Avgruppera" Click="Ungroup_Click" InputGestureText="Ctrl+Shift+G"/><Separator/><MenuItem Header="Duplicera" Click="Duplicate_Click" InputGestureText="Ctrl+D"/><MenuItem Header="Ta bort markerat" Click="Delete_Click" InputGestureText="Delete"/></MenuItem>
 <MenuItem Header="_Rita"><MenuItem Header="Markera / flytta" Click="SelectTool_Click"/><MenuItem Header="Rektangel" Click="RectangleTool_Click"/><MenuItem Header="Ellips" Click="EllipseTool_Click"/><MenuItem Header="Polylinje" Click="PolylineTool_Click"/><Separator/><MenuItem Header="Stäng polylinje" Click="ClosePolyline_Click"/><MenuItem Header="Snappning på/av" Click="ToggleSnap_Click"/></MenuItem>
 <MenuItem Header="_Objekt"><MenuItem Header="Förena" Click="Union_Click"/><MenuItem Header="Subtrahera" Click="Difference_Click"/><MenuItem Header="Skärning" Click="Intersection_Click"/><MenuItem Header="XOR" Click="Xor_Click"/><Separator/><MenuItem Header="Kontrollera vektorer" Click="VectorCheck_Click"/></MenuItem>
 <MenuItem Header="_CAM"><MenuItem Header="V-carve inlay-inställningar" Click="OpenInlay_Click"/><Separator/><MenuItem Header="Visa CAM-panel" Click="ShowPanel_Click" Tag="Cam"/><MenuItem Header="Beräkna körbanor" Click="PreviewContour_Click"/><MenuItem Header="Visa/dölj XY-konturer (ej G-code)" Click="ToggleContourPreview_Click"/><MenuItem Header="Kontrollera fastspänningar (endast XY)" Click="ReviewCamSafety_Click"/><MenuItem Header="CAM-inställningar för markerat objekt" Click="ShowPanel_Click" Tag="Cam"/></MenuItem>
 <MenuItem Header="_Visa"><MenuItem Header="Maskinvy" Click="MachineView_Click"/><MenuItem Header="Materialvy" Click="StockView_Click"/><Separator/><MenuItem Header="Anpassa material" Click="Fit_Click" InputGestureText="F"/><MenuItem Header="Zoom 100 %" Click="ActualSize_Click"/><Separator/><MenuItem Header="Visa ritverktyg" Click="ShowPanel_Click" Tag="Tools"/><MenuItem Header="Visa egenskaper" Click="ShowPanel_Click" Tag="Properties"/><MenuItem Header="Visa CAM-panel" Click="ShowPanel_Click" Tag="Cam"/><MenuItem Header="Visa maskinkontroll" Click="ShowPanel_Click" Tag="Machine"/><Separator/><MenuItem Header="Arbetsyta: Design" Click="DesignWorkspace_Click"/><MenuItem Header="Arbetsyta: CAM" Click="CamWorkspace_Click"/><MenuItem Header="Arbetsyta: Maskin" Click="MachineWorkspace_Click"/></MenuItem>
 <MenuItem Header="_Maskin"><MenuItem Header="Maskininställningar…" Click="MachineSettings_Click"/><MenuItem Header="GRBL-konsol…" Click="OpenConsole_Click"/><MenuItem Header="Testa gränslägesbrytare…" Click="OpenLimitTest_Click"/><Separator/><MenuItem Header="Rita fastspänningsblock" Click="StartFixture_Click"/><Separator/><MenuItem Header="Visa maskinpanelen" Click="ShowPanel_Click" Tag="Machine"/><Separator/><MenuItem Header="Nolla X (demo)" Click="ZeroX_Click"/><MenuItem Header="Nolla Y (demo)" Click="ZeroY_Click"/><MenuItem Header="Nolla Z (demo)" Click="ZeroZ_Click"/><MenuItem Header="Nolla X + Y, behåll Z (demo)" Click="ZeroXY_Click"/></MenuItem>
 <MenuItem Header="_Hjälp"><MenuItem Header="Om CNC Studio" Click="About_Click"/></MenuItem>
</Menu>
 
<Border DockPanel.Dock="Top" Background="#223243" Padding="8,5">
 <DockPanel LastChildFill="True">
  <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
   <Button Content="Materialvy" Click="StockView_Click" ToolTip="Redigera designen på materialet"/>
   <Button Content="Maskinvy" Click="MachineView_Click" ToolTip="Placera material och fastspänningar"/>
   <Button x:Name="DrawFixtureButton" Content="+ Rita fastspänning" Click="StartFixture_Click" Background="#96522A" ToolTip="Växla till maskinvy och dra en rektangel för att lägga till en fastspänning"/>

   <TextBlock Text="CNC STUDIO" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,17,0"/>
   <Button Content="Nytt" Click="New_Click" ToolTip="Nytt projekt (Ctrl+N)"/>
   <Button Content="Öppna" Click="Open_Click" ToolTip="Öppna projekt (Ctrl+O)"/>
   <Button Content="Spara" Click="Save_Click" ToolTip="Spara (Ctrl+S)"/><Button Content="Importera" Click="ImportVector_Click" ToolTip="Importera SVG eller ASCII DXF"/>
   <Separator Width="14" Opacity="0"/>
   <Button Content="Ångra" Click="Undo_Click" ToolTip="Ctrl+Z"/>
   <Button Content="Gör om" Click="Redo_Click" ToolTip="Ctrl+Y"/>
   <Separator Width="14" Opacity="0"/>
   <Button Content="Anpassa" Click="Fit_Click"/><Button Content="100 %" Click="ActualSize_Click"/>
   <TextBlock x:Name="ZoomLabel" Text="Zoom 100 %" VerticalAlignment="Center" Margin="10,0,12,0" Foreground="#B5C8DD"/>
   <TextBlock x:Name="GridStepLabel" Text="Rutnät: 1 mm" VerticalAlignment="Center" Margin="2,0,12,0" Foreground="#8FDDAD" FontWeight="SemiBold"/>
  </StackPanel>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="Design" Click="DesignWorkspace_Click" ToolTip="Designarbetsyta"/>
   <Button Content="CAM" Click="CamWorkspace_Click" ToolTip="CAM-arbetsyta"/>
   <Button Content="Maskin" Click="MachineWorkspace_Click" ToolTip="Maskinarbetsyta"/>
  </StackPanel>
 </DockPanel>
</Border>
 <StatusBar DockPanel.Dock="Bottom" Background="#223243" Foreground="#D1DCE8"><StatusBarItem><TextBlock x:Name="StatusText" Text="Designläge – maskinstyrning ej ansluten"/></StatusBarItem></StatusBar>
 <Grid x:Name="LayoutGrid">
 <Grid.ColumnDefinitions>
 <ColumnDefinition x:Name="ToolsColumn" Width="144"/><ColumnDefinition x:Name="ToolsSplitterColumn" Width="5"/>
 <ColumnDefinition Width="*"/>
 <ColumnDefinition x:Name="PropertiesSplitterColumn" Width="5"/><ColumnDefinition x:Name="PropertiesColumn" Width="250"/>
 <ColumnDefinition x:Name="MachineSplitterColumn" Width="5"/><ColumnDefinition x:Name="MachineColumn" Width="300"/>
 <ColumnDefinition x:Name="CamSplitterColumn" Width="0"/><ColumnDefinition x:Name="CamColumn" Width="0"/>
 </Grid.ColumnDefinitions>
 <Border x:Name="ToolsPanel" Grid.Column="0" Background="#243447" BorderBrush="#50657D" BorderThickness="0,0,1,0">
    <DockPanel><Border DockPanel.Dock="Top" Background="#30465C" Padding="8,5">
 <DockPanel LastChildFill="True">
  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
   <Button Content="↗" Tag="Tools" Click="FloatPanel_Click" Padding="3,1" Margin="1" ToolTip="Lossa panel som eget fönster"/>
   <Button Content="×" Tag="Tools" Click="HidePanel_Click" Padding="4,1" Margin="1" ToolTip="Dölj panel"/>
  </StackPanel><TextBlock Text="RITVERKTYG" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="Ritverktyg"/>
 </DockPanel></Border><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Border Padding="10"><StackPanel>
 <TextBlock Text="RITA" FontSize="11" FontWeight="Bold" Foreground="#A5C0D9" Margin="0,5,0,7"/>
 <Button x:Name="SelectToolButton" Content="Markera" Click="SelectTool_Click" ToolTip="Markera objekt direkt med vänsterklick"/>
 <Button x:Name="RectangleToolButton" Content="Rektangel" Click="RectangleTool_Click"/>
 <Button x:Name="EllipseToolButton" Content="Ellips" Click="EllipseTool_Click"/>
 <Button x:Name="PolylineToolButton" Content="Polylinje" Click="PolylineTool_Click"/>
 <Button Content="Stäng linje" Click="ClosePolyline_Click"/>
 <Separator Margin="0,9"/>
 <Button x:Name="SnapButton" Content="Snap: På" Click="ToggleSnap_Click"/>
 <TextBlock Text="OBJEKT" FontSize="11" FontWeight="Bold" Foreground="#A5C0D9" Margin="0,14,0,7"/>
 <Button Content="Förena" Click="Union_Click"/>
 <Button Content="Subtrahera" Click="Difference_Click"/>
 <Button Content="Skärning" Click="Intersection_Click"/>
 <Button Content="XOR" Click="Xor_Click"/>
 <Button Content="Vektorkoll" Click="VectorCheck_Click"/>
 <Separator Margin="0,9"/>
 <Button Content="Duplicera" Click="Duplicate_Click"/>
 <Button Content="Ta bort" Click="Delete_Click"/>
 </StackPanel></Border></ScrollViewer></DockPanel>
   </Border>
 <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#465D75" ResizeBehavior="PreviousAndNext"/>
 <Grid Grid.Column="2" Background="#101B27" ClipToBounds="True">
  <Canvas x:Name="Viewport" Background="#101B27" ClipToBounds="True" SizeChanged="Viewport_SizeChanged" MouseWheel="Viewport_Wheel" MouseMove="Viewport_MouseMove" MouseDown="Viewport_MouseDown" MouseUp="Viewport_MouseUp">
   <Canvas x:Name="DesignCanvas" Width="600" Height="600" Background="#F2E4CF" MouseLeftButtonDown="Canvas_Down" MouseRightButtonDown="Canvas_RightDown" MouseMove="Canvas_Move" MouseLeftButtonUp="Canvas_Up">
    <Canvas.RenderTransform><TransformGroup><ScaleTransform x:Name="DesignScale" ScaleX="1" ScaleY="1"/><TranslateTransform x:Name="DesignOffset"/></TransformGroup></Canvas.RenderTransform>
   </Canvas>
   <Canvas x:Name="MachineCanvas" Visibility="Collapsed" Background="#D9E1E5"
           MouseLeftButtonDown="Machine_Down" MouseMove="Machine_Move" MouseLeftButtonUp="Machine_Up">
    <Canvas.RenderTransform><TransformGroup><ScaleTransform x:Name="MachineScale" ScaleX="1" ScaleY="1"/><TranslateTransform x:Name="MachineOffset"/></TransformGroup></Canvas.RenderTransform>
   </Canvas>
  </Canvas>
  <!-- Screen-space rulers do not scale with the material; they follow its transform. -->
  <Canvas x:Name="TopRuler" Height="30" VerticalAlignment="Top" Background="#283C50" IsHitTestVisible="False" ClipToBounds="True" Panel.ZIndex="10"/>
  <Canvas x:Name="LeftRuler" Width="38" HorizontalAlignment="Left" Background="#283C50" IsHitTestVisible="False" ClipToBounds="True" Panel.ZIndex="10"/>
  <Border Background="#283C50" Width="38" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Panel.ZIndex="11">
   <TextBlock Text="mm" FontSize="10" FontWeight="SemiBold" Foreground="#DAE8F5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
  </Border>
  <Border Background="#26394D" CornerRadius="4" Padding="9,5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" IsHitTestVisible="False"><TextBlock Text="Hjul: zoom  |  Mittenknapp: panorera  |  Ctrl+klick: flermarkera  |  Ctrl+Z/Y: ångra/gör om" Foreground="#D7E7F5" FontSize="12"/></Border>
 </Grid>
 <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#465D75" ResizeBehavior="PreviousAndNext"/>
 <Border x:Name="PropertiesPanel" Grid.Column="4" Background="#243447" BorderBrush="#50657D" BorderThickness="0,0,1,0">
    <DockPanel><Border DockPanel.Dock="Top" Background="#30465C" Padding="8,5">
 <DockPanel LastChildFill="True">
  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
   <Button Content="↗" Tag="Properties" Click="FloatPanel_Click" Padding="5,2" Margin="2" ToolTip="Lossa panel som eget fönster"/>
   <Button Content="×" Tag="Properties" Click="HidePanel_Click" Padding="6,2" Margin="2" ToolTip="Dölj panel"/>
  </StackPanel><TextBlock Text="PROJEKT / EGENSKAPER" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
 </DockPanel></Border><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Border Padding="10"><StackPanel>
          
          <TextBlock Text="Projektnamn"/><TextBox x:Name="NameBox" Text="Nytt projekt"/>
          <TextBlock Text="Materialbredd (mm)"/><TextBox x:Name="MaterialWidthBox" Text="600"/>
          <TextBlock Text="Materialhöjd (mm)"/><TextBox x:Name="MaterialHeightBox" Text="600"/>
          <TextBlock Text="Materialtjocklek (mm)"/><TextBox x:Name="MaterialThicknessBox" Text="18"/>
          <Button Content="Uppdatera material" Click="UpdateMaterial_Click" Margin="3,8"/>
          <Expander Header="MASKIN OCH MATERIALPLACERING" IsExpanded="True" Margin="0,12,0,3">
           <StackPanel>
            <Border Background="#1C2A39" Padding="8" CornerRadius="4" Margin="3,2,3,6">
              <TextBlock x:Name="MachineSummaryText" Text="" TextWrapping="Wrap" FontSize="11.5" Foreground="#D5E3F0"/>
            </Border>
            <Button Content="Maskininställningar…" Click="MachineSettings_Click" Background="#24618C" ToolTip="Arbetsområde, Z-rörelse, homing, gränslägesbrytare och säkerhetsmarginal"/>
            <TextBlock Text="Materialets X-position (maskinvy, mm)" Margin="0,8,0,0"/><TextBox x:Name="StockXBox" Text="50"/>
            <TextBlock Text="Materialets Y-position (maskinvy, mm)"/><TextBox x:Name="StockYBox" Text="50"/>
            <Button Content="Spara materialplacering" Click="SaveMachineSetup_Click"/>
            <TextBlock Text="OBS: Dessa X/Y-värden är ritningskoordinater. GRBL-mappning är ännu inte kalibrerad." TextWrapping="Wrap" Foreground="#FFD39F" Margin="3,6"/>
           </StackPanel>
          </Expander>
          <Expander Header="Z-HÖJDER OCH Z-BRYTARE" IsExpanded="True" Margin="0,8,0,3">
           <StackPanel>
            <TextBlock Text="Alla höjder i mm över materialytan (Z0 = materialets ovansida)." TextWrapping="Wrap" Foreground="#BDCEE0" Margin="3,2,3,6" FontSize="11"/>
            <TextBlock Text="Förflyttningshöjd (snabbförflyttning)"/><TextBox x:Name="TravelHeightBox" Text="10" ToolTip="Höjd för snabbförflyttningar mellan skären. Höjs automatiskt över fastspänningar."/>
            <TextBlock Text="Höjd före nedmatning"/><TextBox x:Name="PlungeClearanceBox" Text="2" ToolTip="Fräsen går snabbt ned hit och matar sedan långsamt in i materialet."/>
            <TextBlock Text="Maskinens Z vid materialytan (MPos Z)" TextWrapping="Wrap"/><TextBox x:Name="ZMaxBox" Text="" ToolTip="Efter homing är Z-brytaren MPos Z 0. Sätt Z-nollan på materialytan och läs av MPos Z i gSender (negativt värde, t.ex. -45.2). Lämna tomt om okänt (ger varning)."/>
            <Button Content="Läs från maskinen ($#)" Click="ReadZeroFromMachine_Click" ToolTip="Läser G54-offset, G92 och verktygslängd från maskinen. Kräver att Z-nollan är satt på materialytan."/>
            <TextBlock x:Name="ZHeadroomText" Text="" TextWrapping="Wrap" Foreground="#9FD8A8" FontSize="11" Margin="3,2,3,4"/>
            <Button Content="Spara Z-höjder" Click="SaveMotion_Click"/>
            <TextBlock Text="Maskinen homas med $H vid start. Z-brytaren sitter högst upp vid MPos Z 0 (efter $H står Z på −$27). Läs av MPos Z igen när Z-nollan sätts om (nytt material eller ny fräs)." TextWrapping="Wrap" Foreground="#FFD39F" Margin="3,6" FontSize="11"/>
           </StackPanel>
          </Expander>
          <Expander Header="FASTSPÄNNING / HINDER" IsExpanded="True" Margin="0,9,0,3">
           <StackPanel>
            <Button Content="Rita fastspänningsblock i maskinvyn" Click="StartFixture_Click"/>
            <TextBlock Text="Valt hinder"/><TextBlock x:Name="FixtureSelectionLabel" Text="Inget hinder valt" Foreground="#B8CADC"/>
            <TextBlock Text="Namn"/><TextBox x:Name="FixtureNameBox" Text="Klämma"/>
            <TextBlock Text="X (mm)"/><TextBox x:Name="FixtureXBox" Text="0"/>
            <TextBlock Text="Y (mm)"/><TextBox x:Name="FixtureYBox" Text="0"/>
            <TextBlock Text="Bredd (mm)"/><TextBox x:Name="FixtureWidthBox" Text="30"/>
            <TextBlock Text="Längd (mm)"/><TextBox x:Name="FixtureLengthBox" Text="20"/>
            <TextBlock Text="Höjd över materialets ovansida (mm)"/><TextBox x:Name="FixtureHeightBox" Text="20"/>
            <TextBlock Text="Extra säkerhetsmarginal (mm)"/><TextBox x:Name="FixtureClearanceBox" Text="5"/>
            <CheckBox x:Name="FixtureLockedBox" Content="Lås position" Margin="4,6"/>
            <Button Content="Uppdatera valt hinder" Click="SaveFixture_Click"/>
            <Button Content="Ta bort valt hinder" Click="DeleteFixture_Click"/>
           </StackPanel>
          </Expander>
          <Separator Margin="0,13"/>
          <TextBlock Text="MARKERAT OBJEKT" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>
          <TextBlock x:Name="SelectedLabel" Text="Inget objekt markerat" Margin="0,0,0,9"/>
          <TextBlock Text="X (mm)"/><TextBox x:Name="XBox" LostKeyboardFocus="ObjectProperty_LostKeyboardFocus" KeyDown="ObjectProperty_KeyDown"/>
          <TextBlock Text="Y (mm)"/><TextBox x:Name="YBox" LostKeyboardFocus="ObjectProperty_LostKeyboardFocus" KeyDown="ObjectProperty_KeyDown"/>
          <TextBlock Text="Bredd (mm)"/><TextBox x:Name="WidthBox" LostKeyboardFocus="ObjectProperty_LostKeyboardFocus" KeyDown="ObjectProperty_KeyDown"/>
          <TextBlock Text="Höjd (mm)"/><TextBox x:Name="HeightBox" LostKeyboardFocus="ObjectProperty_LostKeyboardFocus" KeyDown="ObjectProperty_KeyDown"/>
          <TextBlock Text="Ändringar sparas när du trycker Tab eller Enter." TextWrapping="Wrap" Foreground="#AFBDD0" Margin="3,8"/>
          <TextBlock Margin="0,12,0,0" Text="Klicka direkt på ett objekt för att markera. Klicka och dra på tom yta för att rita med valt verktyg." TextWrapping="Wrap" Foreground="#AFBDD0"/>
        </StackPanel>
      </Border></ScrollViewer></DockPanel>
   </Border>
 <GridSplitter Grid.Column="5" Width="5" HorizontalAlignment="Stretch" Background="#465D75" ResizeBehavior="PreviousAndNext"/>
 <Border x:Name="MachinePanel" Grid.Column="6" Background="#17212C" BorderBrush="#50657D" BorderThickness="0,0,1,0">
    <DockPanel><Border DockPanel.Dock="Top" Background="#30465C" Padding="8,5">
 <DockPanel LastChildFill="True">
  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
   <Button Content="↗" Tag="Machine" Click="FloatPanel_Click" Padding="5,2" Margin="2" ToolTip="Lossa panel som eget fönster"/>
   <Button Content="×" Tag="Machine" Click="HidePanel_Click" Padding="6,2" Margin="2" ToolTip="Dölj panel"/>
  </StackPanel><TextBlock Text="MASKINKONTROLL" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
 </DockPanel></Border><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Border Padding="10"><StackPanel>
          
          <Border x:Name="ConnectionBanner" Background="#533C34" CornerRadius="5" Padding="10" Margin="0,0,0,8">
            <StackPanel>
              <TextBlock x:Name="ConnectionStateText" Text="EJ ANSLUTEN" FontWeight="Bold" Foreground="#FFD0A8" HorizontalAlignment="Center"/>
              <TextBlock x:Name="ConnectionDetailText" Text="" TextWrapping="Wrap" FontSize="11" Foreground="#E8DCD0" HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>
          </Border>
          <DockPanel Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Content="⟳" Click="RefreshPorts_Click" ToolTip="Uppdatera listan med COM-portar" Padding="8,4"/>
            <ComboBox x:Name="PortPicker" Margin="3" ToolTip="COM-port för GRBL-kontrollern (115200 baud, 8-N-1)"/>
          </DockPanel>
          <Button x:Name="ConnectButton" Content="Anslut" Click="Connect_Click" Background="#24618C"/>
          <Grid Margin="0,6,0,2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <TextBlock Text="Läge" Foreground="#B8CADC" Margin="3,1,10,1"/><TextBlock x:Name="LiveStateText" Grid.Column="1" Text="–" FontWeight="Bold"/>
            <TextBlock Grid.Row="1" Text="MPos" Foreground="#B8CADC" Margin="3,1,10,1"/><TextBlock x:Name="LiveMPosText" Grid.Row="1" Grid.Column="1" Text="–" FontFamily="Consolas"/>
            <TextBlock Grid.Row="2" Text="WPos" Foreground="#B8CADC" Margin="3,1,10,1"/><TextBlock x:Name="LiveWPosText" Grid.Row="2" Grid.Column="1" Text="–" FontFamily="Consolas"/>
          </Grid>
          <Button Content="GRBL-konsol…" Click="OpenConsole_Click" ToolTip="Skicka enskilda kommandon till maskinen"/>
          <Button Content="Testa gränslägesbrytare…" Click="OpenLimitTest_Click" ToolTip="Tryck in brytarna för hand och se att de fungerar – gör detta före homing. Maskinen rör sig inte."/>
          <Separator Margin="0,12"/>
          <TextBlock Text="Arbetskoordinater G54 (endast demonstration)" Foreground="#B8CADC" TextWrapping="Wrap" Margin="0,0,0,8"/>
          <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"><TextBlock Text="X" HorizontalAlignment="Center" FontSize="18"/><TextBlock x:Name="XPosition" Text="125.000" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center"/><Button Content="Nolla X" Click="ZeroX_Click"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="Y" HorizontalAlignment="Center" FontSize="18"/><TextBlock x:Name="YPosition" Text="85.000" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center"/><Button Content="Nolla Y" Click="ZeroY_Click"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Z" HorizontalAlignment="Center" FontSize="18"/><TextBlock x:Name="ZPosition" Text="-2.500" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center"/><Button Content="Nolla Z" Click="ZeroZ_Click"/></StackPanel>
          </Grid>
          <Button Content="Nolla X + Y (behåll Z)" Click="ZeroXY_Click" Background="#24618C"/>
          <TextBlock Text="Ställ in en arbetskoordinat separat" Margin="0,15,0,5"/>
          <WrapPanel><ComboBox x:Name="AxisPicker" Width="60" SelectedIndex="0"><ComboBoxItem Content="X"/><ComboBoxItem Content="Y"/><ComboBoxItem Content="Z"/></ComboBox><TextBox x:Name="SetPositionBox" Text="0" Width="92"/><Button Content="Sätt värde" Click="SetPosition_Click"/></WrapPanel>
          <Separator Margin="0,18"/>
          <TextBlock Text="JOGGING (demonstration)" FontWeight="Bold" Margin="0,0,0,9"/>
          <UniformGrid Columns="3" HorizontalAlignment="Center">
            <TextBlock/><Button Content="Y+" Click="Jog_Click" Tag="Y+"/><TextBlock/>
            <Button Content="X-" Click="Jog_Click" Tag="X-"/><TextBlock Text="XY" HorizontalAlignment="Center"/><Button Content="X+" Click="Jog_Click" Tag="X+"/>
            <TextBlock/><Button Content="Y-" Click="Jog_Click" Tag="Y-"/><TextBlock/>
          </UniformGrid>
          <WrapPanel HorizontalAlignment="Center" Margin="0,7"><Button Content="Z+" Tag="Z+" Click="Jog_Click"/><Button Content="Z-" Tag="Z-" Click="Jog_Click"/></WrapPanel>
          <TextBlock Text="Steg (mm)"/><ComboBox x:Name="StepPicker" SelectedIndex="2" Margin="3"><ComboBoxItem Content="0.1"/><ComboBoxItem Content="1"/><ComboBoxItem Content="10"/><ComboBoxItem Content="100"/></ComboBox>
          <TextBlock Text="Nollning och jogg här är fortfarande DEMO och skickar inget till maskinen. Använd GRBL-konsolen för riktiga kommandon." TextWrapping="Wrap" Foreground="#FFCE96" Margin="0,15,0,0"/>
        </StackPanel>
      </Border></ScrollViewer></DockPanel>
   </Border>
 <GridSplitter Grid.Column="7" Width="5" HorizontalAlignment="Stretch" Background="#465D75" ResizeBehavior="PreviousAndNext"/>
 <Border x:Name="CamPanel" Grid.Column="8" Visibility="Collapsed" Background="#27384C" BorderBrush="#50657D" BorderThickness="0,0,1,0">
    <DockPanel><Border DockPanel.Dock="Top" Background="#30465C" Padding="8,5">
 <DockPanel LastChildFill="True">
  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
   <Button Content="↗" Tag="Cam" Click="FloatPanel_Click" Padding="5,2" Margin="2" ToolTip="Lossa panel som eget fönster"/>
   <Button Content="×" Tag="Cam" Click="HidePanel_Click" Padding="6,2" Margin="2" ToolTip="Dölj panel"/>
  </StackPanel><TextBlock Text="SMART CAM" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
 </DockPanel></Border><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Border Padding="10"><StackPanel>
            
            <TextBlock x:Name="CamSelectionLabel" Text="Markera ett objekt först." TextWrapping="Wrap" Margin="0,0,0,12" Foreground="#BDCEE0"/>
            <TextBlock Text="Bearbetning"/>
            <ComboBox x:Name="CamKind" SelectedIndex="0" Margin="3,5,3,12" SelectionChanged="CamInput_Changed">
              <ComboBoxItem Content="Utvändig kontur (Outside)"/><ComboBoxItem Content="Invändig kontur (Inside)"/><ComboBoxItem Content="Fickfräsning (Pocket)"/>
            </ComboBox>
            <TextBlock Text="Fräsdiameter (mm)"/><TextBox x:Name="CamDiameter" Text="3.175" TextChanged="CamInput_Changed"/>
            <TextBlock Text="Totalt djup (mm)" Margin="0,8,0,0"/><TextBox x:Name="CamDepth" Text="6" TextChanged="CamInput_Changed"/>
            <TextBlock Text="Djup per pass (mm)" Margin="0,8,0,0"/><TextBox x:Name="CamPass" Text="2" TextChanged="CamInput_Changed"/>
            <CheckBox x:Name="CamTabs" IsChecked="True" Content="Hållflikar (vid genomskärning)" Margin="4,14,4,6" Checked="CamInput_Changed" Unchecked="CamInput_Changed"/>
            <Grid x:Name="TabSettingsPanel" Margin="18,0,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0"><TextBlock Text="Antal" FontSize="11"/><TextBox x:Name="CamTabCount" Text="4" TextChanged="CamInput_Changed" ToolTip="Flikar per sluten bana. Färre placeras om banan är för kort."/></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="Bredd mm" FontSize="11"/><TextBox x:Name="CamTabWidth" Text="6" TextChanged="CamInput_Changed" ToolTip="Bredden på materialbryggan vid delen."/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Höjd mm" FontSize="11"/><TextBox x:Name="CamTabHeight" Text="3" TextChanged="CamInput_Changed" ToolTip="Flikens höjd ovanför spårets botten."/></StackPanel>
            </Grid>
            <Border Background="#1C2A39" Padding="10" CornerRadius="4" Margin="0,6,0,8">
              <TextBlock x:Name="CamSummary" Text="3 pass vid 2 mm/pass." TextWrapping="Wrap" Foreground="#D5E3F0"/>
            </Border>
            <Button Content="Spara CAM till markerat objekt" Background="#24618C" Click="SaveCam_Click" Margin="3,9"/>
            <Button Content="Ta bort objektets CAM" Click="RemoveCam_Click"/>
            <Button x:Name="ComputePathsButton" Content="Beräkna körbanor" Click="PreviewContour_Click" Background="#23623F" Margin="3,10,3,4" ToolTip="Räknar om alla inaktuella körbanor. Enkla former räknas om automatiskt; stora DXF/SVG/Boolean-former först när du klickar här."/>
            <CheckBox x:Name="ContourVisibilityCheck" Content="Visa sparade verktygsbanor i båda vyerna" IsChecked="True" Checked="ContourVisibility_Changed" Unchecked="ContourVisibility_Changed" Margin="4,8" Foreground="#D4E8D8"/>
            <Button Content="Kontrollera hinder (XY)" Click="ReviewCamSafety_Click" Background="#80532B" ToolTip="Kontroll av skärande XY-konturer mot fastspänningar och maskinens XY-gränser; ej full säkerhetskontroll"/>
            <Border x:Name="CamHealthBorder" Background="#1C2A39" BorderBrush="#50657D" BorderThickness="1" Padding="9" CornerRadius="4" Margin="0,10,0,4">
              <StackPanel>
                <TextBlock x:Name="CamHealthHeader" Text="CAM-kontroll" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#D5E3F0"/>
                <TextBlock x:Name="CamHealthText" Text="Inga CAM-operationer." TextWrapping="Wrap" Foreground="#D5E3F0" Margin="0,5,0,0" FontSize="11.5"/>
              </StackPanel>
            </Border>
            <TextBlock Text="Grön streckad linje = fräscentrum. Gula partier = hållflikar (fräsen lyfts där). Slutna rektanglar, ellipser, DXF/SVG- och Boolean-konturer (Outside/Inside). Fickor, säkra Z-förflyttningar och G-code saknas fortfarande." Foreground="#FFD18C" Margin="1,6,1,2" TextWrapping="Wrap"/>
            <TextBlock Margin="0,15,0,0" Foreground="#FFCE96" TextWrapping="Wrap" Text="CAM är än så länge en XY-förhandsvisning; inga körbara fräsprogram skapas. Hållflikarna är planerade lägen för kommande G-code."/>
            <Expander x:Name="InlayExpander" Header="V-CARVE INLAY · hona + hane" IsExpanded="False" Margin="0,16,0,0" Foreground="#E8F1FA">
              <StackPanel Margin="4,10,4,4">
                <TextBlock Text="InlayStudio-inställningar integrerade i projektet" TextWrapping="Wrap" Foreground="#BDCEE0" Margin="0,0,0,9"/>
                <TextBlock Text="Jobbtyp"/><ComboBox x:Name="InlayKind" SelectedIndex="0" Margin="3,4,3,9"><ComboBoxItem Content="Hona + hane"/><ComboBoxItem Content="Endast hona"/><ComboBoxItem Content="Endast hane"/><ComboBoxItem Content="Endast V-carve"/></ComboBox>
                <TextBlock Text="V-fräsens vinkel (grader)"/><TextBox x:Name="InlayAngle" Text="60"/>
                <TextBlock Text="V-fräsdiameter (mm)"/><TextBox x:Name="InlayVBitDia" Text="12.7"/>
                <TextBlock Text="Plan spets (mm)"/><TextBox x:Name="InlayTip" Text="0.2"/>
                <TextBlock Text="Honans djup (mm)"/><TextBox x:Name="InlayFemaleDepth" Text="3"/>
                <TextBlock Text="Hanens djup (mm)"/><TextBox x:Name="InlayMaleDepth" Text="3"/>
                <TextBlock Text="Hanens startdjup (mm)"/><TextBox x:Name="InlayStart" Text="1.5"/>
                <TextBlock Text="Limspalt (mm)"/><TextBox x:Name="InlayGlue" Text="0.2"/>
                <TextBlock Text="Passningsspel (mm)"/><TextBox x:Name="InlayClearance" Text="0.1"/>
                <TextBlock Text="Planfräsdiameter (mm)"/><TextBox x:Name="InlayCleanupDia" Text="3"/>
                <TextBlock Text="Överlapp planfräs (%)"/><TextBox x:Name="InlayStepover" Text="40"/>
                <TextBlock Text="Matning XY (mm/min)"/><TextBox x:Name="InlayFeed" Text="1500"/>
                <TextBlock Text="Matning Z (mm/min)"/><TextBox x:Name="InlayPlunge" Text="500"/>
                <TextBlock Text="Säker Z (mm)"/><TextBox x:Name="InlaySafeZ" Text="5"/>
                <TextBlock Text="Spindel (rpm)"/><TextBox x:Name="InlayRpm" Text="18000"/>
                <CheckBox x:Name="InlayMirrorFemale" Content="Spegla hona (X)" IsChecked="True" Margin="4,7"/>
                <CheckBox x:Name="InlayMirrorMale" Content="Spegla hane (X)" IsChecked="True" Margin="4,7"/>
                <Button Content="Spara V-carve inlay-inställningar" Click="SaveInlay_Click" Background="#24618C" Margin="2,9,2,3"/>
                <Button Content="Ta bort inlay-inställningar" Click="RemoveInlay_Click"/>
                <TextBlock x:Name="InlaySummary" Text="Konfiguration – ännu ingen G-code-generering." Foreground="#FFD39F" TextWrapping="Wrap" Margin="0,10,0,0"/>
                <TextBlock Text="OBS: InlayStudio använder F-Engrave som extern beräkningsmotor. Denna första integration sparar bara inställningar. Fräsprogram och verifiering implementeras separat." Foreground="#FFD39F" TextWrapping="Wrap" Margin="0,8,0,0"/>
              </StackPanel>
            </Expander>

          </StackPanel>
        </Border></ScrollViewer></DockPanel>
   </Border>
 </Grid>
 </DockPanel>
</Window>