      <StackPanel DockPanel.Dock="Bottom">
        <UniformGrid Columns="4">
          <Button x:Name="RunMacroButton" Content="▶ Kör" Click="RunMacro_Click" Background="#2E7A4A" FontWeight="SemiBold" ToolTip="Kör det markerade makrot på maskinen (efter en kontroll och en fråga)"/>
          <Button Content="Ändra…" Click="EditMacro_Click"/>
          <Button Content="Ny…" Click="NewMacro_Click"/>
          <Button Content="Ta bort" Click="DeleteMacro_Click"/>
        </UniformGrid>
        <UniformGrid Columns="2">
          <Button Content="Från G-code-fil…" Click="ImportMacro_Click" ToolTip="Gör ett makro av en .nc/.gcode-fil (kontrolleras innan det kan köras)"/>
          <Button x:Name="StopMacroButton" Content="■ Stoppa makrot" Click="StopMacro_Click" Background="#8A2E26" IsEnabled="False" ToolTip="Bromsar in och återställer, som Stopp för program"/>
        </UniformGrid>
        <TextBlock Text="Svar från maskinen" FontSize="11" Foreground="#8CA3BA" Margin="3,6,3,0"/>
        <TextBox x:Name="MacroOutput" Height="120" IsReadOnly="True" FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#10202E" Foreground="#D5E3F0" BorderBrush="#3C5167"/>
      </StackPanel>
      <ListBox x:Name="MacroList" Margin="3" Background="#10202E" Foreground="#E8F1FA" BorderBrush="#3C5167" MinHeight="120"
               MouseDoubleClick="RunMacro_Click"/>
    </DockPanel>
   </Border>
     </ad:LayoutAnchorable>
    </ad:LayoutAnchorablePane>
    </ad:LayoutAnchorablePaneGroup>
    </ad:LayoutPanel>
    <ad:LayoutAnchorablePaneGroup Orientation="Vertical" DockWidth="330">
    <ad:LayoutAnchorablePane DockHeight="*">
     <ad:LayoutAnchorable ContentId="Properties" Title="Egenskaper" CanClose="False" CanHide="True" FloatingWidth="290" FloatingHeight="700">
 <Border x:Name="PropertiesPanel" Background="#243447" BorderBrush="#50657D" BorderThickness="0,0,1,0">
    <DockPanel><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Border Padding="10"><StackPanel>

         <!-- Design workspace: what you work on first – the selected object – then project and material. -->
         <StackPanel x:Name="DesignSections">
          <Expander x:Name="ObjectExpander" Header="MARKERAT OBJEKT" IsExpanded="True" Margin="0,0,0,3">
           <StackPanel>
            <TextBlock x:Name="SelectedLabel" Text="Inget objekt markerat" Margin="3,2,3,6" Foreground="#B8CADC"/>
            <Grid>
             <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
             <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
             <StackPanel><TextBlock Text="X (mm)"/><TextBox x:Name="XBox" LostKeyboardFocus="ObjectProperty_LostKeyboardFocus" KeyDown="ObjectProperty_KeyDown"/></StackPanel>
             <StackPanel Grid.Column="1"><TextBlock Text="Y (mm)"/><TextBox x:Name="YBox" LostKeyboardFocus="ObjectProperty_LostKeyboardFocus" KeyDown="ObjectProperty_KeyDown"/></StackPanel>
             <StackPanel Grid.Row="1"><TextBlock Text="Bredd (mm)"/><TextBox x:Name="WidthBox" LostKeyboardFocus="ObjectProperty_LostKeyboardFocus" KeyDown="ObjectProperty_KeyDown"/></StackPanel>
             <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="Höjd (mm)"/><TextBox x:Name="HeightBox" LostKeyboardFocus="ObjectProperty_LostKeyboardFocus" KeyDown="ObjectProperty_KeyDown"/></StackPanel>
            </Grid>
            <TextBlock Text="Ändringar gäller när du trycker Tab eller Enter." TextWrapping="Wrap" Foreground="#AFBDD0" FontSize="11" Margin="3,6"/>
           </StackPanel>
          </Expander>
          <Expander Header="PROJEKT OCH MATERIAL" IsExpanded="True" Margin="0,10,0,3">
           <StackPanel>
            <TextBlock Text="Projektnamn"/><TextBox x:Name="NameBox" Text="Nytt projekt"/>
            <Border x:Name="NoMaterialText" Background="#3A3220" BorderBrush="#8A6A1E" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="3,6,3,2" Visibility="Collapsed">
              <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="#FFD39F" Text="Inget material ännu. Ange bredd, höjd och tjocklek och klicka Lägg till material. Utan material beräknas inga körbanor."/>
            </Border>
            <Grid>
             <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
             <StackPanel><TextBlock Text="Bredd"/><TextBox x:Name="MaterialWidthBox" Text="600"/></StackPanel>
             <StackPanel Grid.Column="1"><TextBlock Text="Höjd"/><TextBox x:Name="MaterialHeightBox" Text="600"/></StackPanel>
             <StackPanel Grid.Column="2"><TextBlock Text="Tjocklek"/><TextBox x:Name="MaterialThicknessBox" Text="18"/></StackPanel>
            </Grid>
            <TextBlock Text="Materialets mått i mm." Foreground="#AFBDD0" FontSize="11" Margin="3,2"/>
            <TextBlock Text="Materialtyp" Margin="0,6,0,0"/>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Material…" Click="ManageMaterials_Click" Padding="8,3" ToolTip="Materialbibliotek: lägg upp material i kategorier"/>
              <ComboBox x:Name="MaterialPicker" Margin="3" DisplayMemberPath="DisplayName" SelectionChanged="Material_Changed"
                        ToolTip="Materialet bestämmer vilken skärdata fräsarna använder (från verktygsbiblioteket)."/>
            </DockPanel>
            <TextBlock Text="Nollpunkt X/Y (G54)" Margin="0,6,0,0"/>
            <ComboBox x:Name="WorkZeroPicker" SelectedIndex="0" Margin="3" SelectionChanged="WorkZero_Changed"
                      ToolTip="Var X0 Y0 sätts på materialet innan körning. Z0 är alltid materialets ovansida.">
              <ComboBoxItem Content="Främre vänstra hörnet"/><ComboBoxItem Content="Mitten av materialet"/>
            </ComboBox>
            <Button x:Name="MaterialButton" Content="Uppdatera material" Click="UpdateMaterial_Click" Margin="3,6"/>
           </StackPanel>
          </Expander>
         </StackPanel>

         <!-- Both workspaces: where the material lies on the machine table, from a chosen point on it. -->
         <Expander x:Name="StockPlacementExpander" Header="MATERIAL PÅ BORDET" IsExpanded="False" Margin="0,10,0,3">
          <StackPanel>
           <TextBlock Text="Klicka på materialet i 2D eller 3D för att markera det, och dra sedan. Eller ange var en punkt på materialet ska ligga:" TextWrapping="Wrap" Foreground="#AFBDD0" FontSize="11" Margin="3,0,3,6"/>
           <DockPanel>
            <Border DockPanel.Dock="Left" BorderBrush="#C8A06E" BorderThickness="1" CornerRadius="3" Background="#4A3D2E" Margin="3,2,10,2" Padding="2"
                    ToolTip="Vilken punkt på materialet X/Y gäller: ett hörn, mitten av en kant eller mitten. Överst = bakre kanten.">
             <Grid x:Name="StockAnchorGrid">
              <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <RadioButton GroupName="StockAnchor" Grid.Row="0" Grid.Column="0" Tag="0,0" Checked="StockAnchor_Checked" Margin="4" HorizontalAlignment="Center"/><RadioButton GroupName="StockAnchor" Grid.Row="0" Grid.Column="1" Tag="1,0" Checked="StockAnchor_Checked" Margin="4" HorizontalAlignment="Center"/><RadioButton GroupName="StockAnchor" Grid.Row="0" Grid.Column="2" Tag="2,0" Checked="StockAnchor_Checked" Margin="4" HorizontalAlignment="Center"/><RadioButton GroupName="StockAnchor" Grid.Row="1" Grid.Column="0" Tag="0,1" Checked="StockAnchor_Checked" Margin="4" HorizontalAlignment="Center"/><RadioButton GroupName="StockAnchor" Grid.Row="1" Grid.Column="1" Tag="1,1" Checked="StockAnchor_Checked" Margin="4" HorizontalAlignment="Center"/><RadioButton GroupName="StockAnchor" Grid.Row="1" Grid.Column="2" Tag="2,1" Checked="StockAnchor_Checked" Margin="4" HorizontalAlignment="Center"/><RadioButton GroupName="StockAnchor" Grid.Row="2" Grid.Column="0" Tag="0,2" Checked="StockAnchor_Checked" Margin="4" HorizontalAlignment="Center"/><RadioButton GroupName="StockAnchor" Grid.Row="2" Grid.Column="1" Tag="1,2" Checked="StockAnchor_Checked" Margin="4" HorizontalAlignment="Center"/><RadioButton GroupName="StockAnchor" Grid.Row="2" Grid.Column="2" Tag="2,2" Checked="StockAnchor_Checked" Margin="4" HorizontalAlignment="Center"/>
             </Grid>
            </Border>
            <StackPanel VerticalAlignment="Center">
             <TextBlock x:Name="StockAnchorText" Text="Punkt: främre vänstra hörnet" Foreground="#E8F1FA" Margin="3,0,3,4" TextWrapping="Wrap"/>
             <TextBlock x:Name="StockOriginText" Text="Mätt från hemhörnet." Foreground="#AFBDD0" FontSize="11" Margin="3,0" TextWrapping="Wrap"/>
            </StackPanel>
           </DockPanel>
           <CheckBox x:Name="StockLockBox" Content="Lås materialet" Foreground="#E8F1FA" Margin="3,6,3,2" Checked="StockLock_Changed" Unchecked="StockLock_Changed"
                     ToolTip="Låst material kan inte dras (i 2D eller 3D) eller få ny position förrän du låser upp det. Sparas med projektet."/>
           <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="X (mm)"/><TextBox x:Name="StockXBox" Text="50" KeyDown="StockBox_KeyDown"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="Y (mm)"/><TextBox x:Name="StockYBox" Text="50" KeyDown="StockBox_KeyDown"/></StackPanel>
           </Grid>
           <Button x:Name="StockMoveButton" Content="Flytta materialet dit" Click="SaveMachineSetup_Click" ToolTip="Flytta materialet så att den valda punkten hamnar på X/Y (Enter i fälten gör samma sak)"/>
          </StackPanel>
         </Expander>

         <!-- Maskin workspace: the machine table. -->
         <StackPanel x:Name="MachineSections" Visibility="Collapsed">
          <Expander Header="FASTSPÄNNINGAR" IsExpanded="True" Margin="0,0,0,3">
           <StackPanel>
            <Button x:Name="DrawFixtureButton" Content="+ Rita fastspänning" Click="StartFixture_Click" Background="#96522A" Foreground="White"
                    ToolTip="Dra en rektangel på maskinbordet för att lägga till en fastspänning. Esc avbryter."/>
            <TextBlock Text="Vald fastspänning" Margin="0,8,0,0"/><TextBlock x:Name="FixtureSelectionLabel" Text="Ingen vald – klicka på en på bordet" Foreground="#B8CADC" Margin="3,0,3,4"/>
            <TextBlock Text="Namn"/><TextBox x:Name="FixtureNameBox" Text="Klämma"/>
            <Grid>
             <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
             <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
             <StackPanel><TextBlock Text="X (mm)"/><TextBox x:Name="FixtureXBox" Text="0"/></StackPanel>
             <StackPanel Grid.Column="1"><TextBlock Text="Y (mm)"/><TextBox x:Name="FixtureYBox" Text="0"/></StackPanel>
             <StackPanel Grid.Row="1"><TextBlock Text="Bredd (mm)"/><TextBox x:Name="FixtureWidthBox" Text="30"/></StackPanel>
             <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="Längd (mm)"/><TextBox x:Name="FixtureLengthBox" Text="20"/></StackPanel>
             <StackPanel Grid.Row="2"><TextBlock Text="Höjd över material" ToolTip="Höjd över materialets ovansida (mm)"/><TextBox x:Name="FixtureHeightBox" Text="20"/></StackPanel>
             <StackPanel Grid.Row="2" Grid.Column="1"><TextBlock Text="Marginal (mm)" ToolTip="Extra säkerhetsmarginal runt fastspänningen"/><TextBox x:Name="FixtureClearanceBox" Text="5"/></StackPanel>
            </Grid>
            <CheckBox x:Name="FixtureLockedBox" Content="Lås position" Margin="4,6" Foreground="#E8F1FA"/>
            <UniformGrid Columns="2">
             <Button Content="Uppdatera" Click="SaveFixture_Click" ToolTip="Spara värdena för vald fastspänning"/>
             <Button Content="Ta bort" Click="DeleteFixture_Click" ToolTip="Ta bort vald fastspänning"/>
            </UniformGrid>
           </StackPanel>
          </Expander>
          <Expander x:Name="ZExpander" Header="Z-HÖJDER OCH Z-BRYTARE" IsExpanded="True" Margin="0,10,0,3">
           <StackPanel>
            <TextBlock Text="Alla höjder i mm över materialytan (Z0 = materialets ovansida)." TextWrapping="Wrap" Foreground="#BDCEE0" Margin="3,2,3,6" FontSize="11"/>
            <TextBlock Text="Förflyttningshöjd (snabbförflyttning)"/><TextBox x:Name="TravelHeightBox" Text="10" ToolTip="Höjd för snabbförflyttningar mellan skären. Höjs automatiskt över fastspänningar."/>
            <TextBlock Text="Höjd före nedmatning"/><TextBox x:Name="PlungeClearanceBox" Text="2" ToolTip="Fräsen går snabbt ned hit och matar sedan långsamt in i materialet."/>
            <CheckBox x:Name="RapidIntoCutBox" Content="Snabbt ned i redan fräst spår" Margin="3,6,3,0" Click="RapidIntoCut_Click" ToolTip="När fräsen går ned igen där det redan är fräst (fickans nästa djup, ett nytt varv efter ett lyft) går den med G0 genom luften och matar bara sista biten."/>
            <StackPanel x:Name="RapidIntoCutPanel"><TextBlock Text="   … till höjd över fräst djup"/><TextBox x:Name="RapidIntoCutClearanceBox" Text="0.5" ToolTip="mm över det djup som redan är fräst. Minst 0,1 mm och högst höjden före nedmatning."/></StackPanel>
            <TextBlock Text="Slutposition" Margin="3,6,3,0"/>
            <ComboBox x:Name="EndPositionPicker" Margin="3" SelectionChanged="EndPosition_Changed" ToolTip="Vart fräsen går när programmet är klart (på start-/sluthöjden).">
              <ComboBoxItem Content="Stanna över sista skäret"/><ComboBoxItem Content="Arbetsnollan (X0 Y0)"/><ComboBoxItem Content="Egen punkt"/>
            </ComboBox>
            <Grid x:Name="EndPointPanel"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
             <StackPanel><TextBlock Text="X (mm)"/><TextBox x:Name="EndXBox" Text="0" ToolTip="Slutpunkt i arbetskoordinater (samma som G-coden)."/></StackPanel>
             <StackPanel Grid.Column="1"><TextBlock Text="Y (mm)"/><TextBox x:Name="EndYBox" Text="0" ToolTip="Slutpunkt i arbetskoordinater (samma som G-coden)."/></StackPanel>
            </Grid>
            <TextBlock Text="Spindelns uppstartstid (s)"/><TextBox x:Name="SpinUpBox" Text="4" ToolTip="Väntetid efter M3 innan första rörelsen (G4 P, sekunder)."/>
            <TextBlock Text="Maskinens Z vid materialytan (MPos Z)" TextWrapping="Wrap"/><TextBox x:Name="ZMaxBox" Text="" ToolTip="Efter homing är Z-brytaren MPos Z 0. Sätt Z-nollan på materialytan och läs av MPos Z (negativt värde, t.ex. -45.2). Lämna tomt om okänt (ger varning)."/>
            <Button Content="Läs från maskinen ($#)" Click="ReadZeroFromMachine_Click" ToolTip="Läser G54-offset, G92 och verktygslängd från maskinen. Kräver att Z-nollan är satt på materialytan."/>
            <TextBlock x:Name="ZHeadroomText" Text="" TextWrapping="Wrap" Foreground="#9FD8A8" FontSize="11" Margin="3,2,3,4"/>
            <Button Content="Spara Z-höjder" Click="SaveMotion_Click"/>
            <TextBlock Text="Maskinen homas med $H vid start. Z-brytaren sitter högst upp vid MPos Z 0 (efter $H står Z på −$27). Läs av MPos Z igen när Z-nollan sätts om (nytt material eller ny fräs)." TextWrapping="Wrap" Foreground="#FFD39F" Margin="3,6" FontSize="11"/>
           </StackPanel>
          </Expander>
          <Expander Header="MASKIN" IsExpanded="True" Margin="0,10,0,3">
           <StackPanel>
            <Border Background="#1C2A39" Padding="8" CornerRadius="4" Margin="3,2,3,6">
              <TextBlock x:Name="MachineSummaryText" Text="" TextWrapping="Wrap" FontSize="11.5" Foreground="#D5E3F0"/>
            </Border>
            <Button Content="Maskiner…" local:Ui.Icon="&#xE772;" Click="Machines_Click" Margin="3,0,3,4" ToolTip="Alla maskiner – välj, ändra, lägg till och ta bort"/>
            <Button Content="Maskininställningar…" local:Ui.Icon="&#xE713;" Click="MachineSettings_Click" Background="#24618C" ToolTip="Arbetsområde, Z-rörelse, homing, gränslägesbrytare och säkerhetsmarginal"/>
           </StackPanel>
          </Expander>
         </StackPanel>
        </StackPanel>
      </Border></ScrollViewer></DockPanel>
   </Border>
     </ad:LayoutAnchorable>
    </ad:LayoutAnchorablePane>
    <ad:LayoutAnchorablePane DockHeight="1.4*">
     <ad:LayoutAnchorable ContentId="Cam" Title="Fräsning" CanClose="False" CanHide="True" FloatingWidth="340" FloatingHeight="700">
 <Border x:Name="CamPanel" Background="#27384C" BorderBrush="#50657D" BorderThickness="0,0,1,0">
    <DockPanel><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Border Padding="10"><StackPanel>
            
            <StackPanel.Resources>
              <Style x:Key="CamSection" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#8CA3BA"/><Setter Property="Margin" Value="3,0,3,4"/></Style>
              <Style x:Key="CamCard" TargetType="Border"><Setter Property="Background" Value="#1C2A39"/><Setter Property="CornerRadius" Value="5"/><Setter Property="Padding" Value="8,6,8,4"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
              <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#BDCEE0"/><Setter Property="Margin" Value="3,0,3,0"/></Style>
            </StackPanel.Resources>

            <!-- ===== THE SELECTED OBJECT ===== -->
            <Border Background="#24384D" CornerRadius="5" Padding="10,8" Margin="0,0,0,10">
              <TextBlock x:Name="CamSelectionLabel" Text="Markera ett objekt först." TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#E8F1FA"/>
            </Border>

            <StackPanel x:Name="CamSettingsPanel">
            <!-- Templates: saved settings, used with one click -->
            <Border Style="{StaticResource CamCard}">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="⋯" Click="CamTemplateMenu_Click" Padding="8,3" ToolTip="Ta bort en mall"/>
                <Button DockPanel.Dock="Right" Content="Spara som mall…" Click="SaveCamTemplate_Click" Padding="8,3" ToolTip="Spara inställningarna nedan som en mall med ett namn"/>
                <ComboBox x:Name="CamTemplatePicker" Margin="3" SelectionChanged="CamTemplate_Changed"
                          ToolTip="Välj en mall: inställningarna fylls i och sparas på den markerade formen direkt"/>
              </DockPanel>
            </Border>
            <!-- 1. What and with what -->
            <Border Style="{StaticResource CamCard}">
              <StackPanel>
                <TextBlock Text="Bearbetning" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CamKind" SelectedIndex="0" Margin="3,3,3,8" SelectionChanged="CamInput_Changed">
                  <ComboBoxItem Content="Utvändig kontur (Outside)"/><ComboBoxItem Content="Invändig kontur (Inside)"/><ComboBoxItem Content="Fickfräsning (Pocket)"/><ComboBoxItem Content="Borrning (Drill)" ToolTip="Hål med fräsens diameter i objektets mitt, rakt ned i steg"/><ComboBoxItem Content="Planfräsning (Face)" ToolTip="Fräser hela objektets yta plan, rad för rad, och går ut förbi kanterna. Körs först."/><ComboBoxItem Content="V-carving (V-fräs)" ToolTip="V-fräsen fräser formen med väggar längs konturen – djupare där formen är bredare, skarpa hörn. För text och skyltar."/><ComboBoxItem Content="Inlay-hane (V-fräs)" ToolTip="Hanen i en V-carve inlay: V-fräsen fräser runt formen så att den står kvar som en plugg. Skapas enklast med CAM → Skapa inlay."/><ComboBoxItem Content="(detaljpass)" Visibility="Collapsed"/><ComboBoxItem Content="(bottenpass)" Visibility="Collapsed"/><ComboBoxItem Content="3D-fräsning (STL)" ToolTip="Fräser en 3D-modell (Rita → 3D-modell från STL) i rader. Med andra fräs: grovfräsning först, sedan finfräsning (t.ex. kulfräs)."/><ComboBoxItem Content="(finfräsning)" Visibility="Collapsed"/><ComboBoxItem Content="Fasning (V-fräs)" ToolTip="V-fräsens spets följer formens kant och fasar den. Ange fasens bredd – djupet räknas ut från fräsens vinkel. För att fasa en del som också skärs ut: välj utskärningen och kryssa i Fasa övre kanten."/>
                </ComboBox>
                <TextBlock Text="Fräs" Style="{StaticResource FieldLabel}"/>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="Fräsar…" Click="ManageTools_Click" Padding="8,3" ToolTip="Verktygsbibliotek: lägg till och ändra fräsar och deras standardvärden"/>
                  <ComboBox x:Name="CamToolPicker" Margin="3" SelectionChanged="CamTool_Changed" DisplayMemberPath="DisplayName"
                            ToolTip="Välj fräs – diameter, matning, nedmatning, djup per pass och varvtal fylls i från biblioteket"/>
                </DockPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Fräsdiameter (mm)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CamDiameter" Text="3.175" TextChanged="CamInput_Changed"/></StackPanel>
                  <StackPanel x:Name="VCarveAnglePanel" Grid.Column="1" Visibility="Collapsed"><TextBlock Text="V-vinkel (grader)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CamVAngle" Text="60" TextChanged="CamInput_Changed" ToolTip="V-fräsens spetsvinkel, t.ex. 60 eller 90. Hämtas från fräsen i biblioteket."/></StackPanel>
                </Grid>
                <Grid x:Name="InlayPlugPanel" Visibility="Collapsed">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Startdjup vid konturen (mm)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CamInlayStart" Text="3" TextChanged="CamInput_Changed" ToolTip="Fräsningen börjar så här djupt precis vid konturen. Måste vara grundare än honans djup – skillnaden blir glipan för lim i botten."/></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock Text="Spel runt om (mm)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CamInlayClearance" Text="0.05" TextChanged="CamInput_Changed" ToolTip="Hanen görs så här mycket mindre runt om, för lim på väggarna."/></StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <!-- 2. How deep -->
            <Border Style="{StaticResource CamCard}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock x:Name="CamDepthLabel" Text="Totalt djup (mm)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CamDepth" Text="6" TextChanged="CamInput_Changed"/></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock x:Name="CamPassLabel" Text="Djup per pass (mm)" Style="{StaticResource FieldLabel}" TextTrimming="CharacterEllipsis"/><TextBox x:Name="CamPass" Text="2" TextChanged="CamInput_Changed"/></StackPanel>
                </Grid>
                <StackPanel x:Name="PocketSettingsPanel" Margin="0,6,0,0" Visibility="Collapsed">
                  <TextBlock x:Name="CamStepoverLabel" Text="Stegning (% av fräsdiametern)" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="CamStepover" Text="40" TextChanged="CamInput_Changed" ToolTip="Avstånd mellan varven i fickan. 30–50 % är vanligt i trä. Fickan fräses inifrån och ut, ett djup i taget; sista varvet följer väggen."/>
                </StackPanel>
                <Grid x:Name="FaceSettingsPanel" Margin="0,6,0,0" Visibility="Collapsed">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                  <StackPanel><TextBlock Text="Ut förbi kanten (mm)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CamFaceOverhang" Text="2" TextChanged="CamInput_Changed" ToolTip="Så långt utanför kanten varje rad går, utöver fräsens radie – fräsen lämnar materialet helt innan den går till nästa rad."/></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock Text="Rader längs" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="CamFaceDirection" SelectedIndex="0" Margin="3" SelectionChanged="CamInput_Changed"><ComboBoxItem Content="X (vänster–höger)"/><ComboBoxItem Content="Y (fram–bak)"/></ComboBox></StackPanel>
                  <CheckBox x:Name="CamFaceCenterReachesLimits" Grid.Row="1" Grid.ColumnSpan="2" Content="Fräsens centrum får nå gränslägena" Margin="4,6,4,2"
                            Checked="CamInput_Changed" Unchecked="CamInput_Changed"
                            ToolTip="För planfräsning av en offerskiva som är större än rörelseområdet: bara fräsens centrum (spindeln) behöver hålla marginalen till gränslägena – fräsen får gå utanför. Av: hela fräsen håller sig innanför, som vid all annan bearbetning."/>
                </Grid>
                <StackPanel x:Name="SecondToolPanel" Margin="0,8,0,0" Visibility="Collapsed">
                  <CheckBox x:Name="CamSecondEnabled" Content="Andra fräs" Margin="4,2,4,4" Checked="CamInput_Changed" Unchecked="CamInput_Changed"/>
                  <StackPanel x:Name="SecondToolFields">
                    <ComboBox x:Name="CamSecondTool" Margin="3" DisplayMemberPath="DisplayName" SelectionChanged="CamSecondTool_Changed" ToolTip="Den andra fräsen – diameter, matning och varvtal hämtas från biblioteket"/>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <StackPanel><TextBlock Text="Diameter (mm)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CamSecondDiameter" Text="3.175" TextChanged="CamInput_Changed"/></StackPanel>
                      <StackPanel Grid.Column="1"><TextBlock Text="Djup per pass (mm)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CamSecondPass" Text="2" TextChanged="CamInput_Changed"/></StackPanel>
                    </Grid>
                    <TextBlock x:Name="CamSecondHint" Text="" TextWrapping="Wrap" FontSize="10.5" Foreground="#8CA3BA" Margin="3,2,3,0"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel x:Name="ChamferPanel" Margin="0,8,0,0" Visibility="Collapsed">
                  <CheckBox x:Name="CamChamferEnabled" Content="Fasa övre kanten med V-fräs (körs först)" Margin="4,2,4,4" Checked="CamInput_Changed" Unchecked="CamInput_Changed"
                            ToolTip="Ett eget program med V-fräsen längs formens kant innan den skärs – medan delen sitter fast. Djupet räknas ut från fasbredden och fräsens vinkel."/>
                  <StackPanel x:Name="ChamferFields">
                    <ComboBox x:Name="CamChamferTool" Margin="3" DisplayMemberPath="DisplayName" SelectionChanged="CamChamferTool_Changed" ToolTip="V-fräsen för fasningen – diameter, vinkel och skärdata hämtas från biblioteket"/>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <StackPanel><TextBlock Text="Fasbredd (mm)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CamChamferWidth" Text="1.5" TextChanged="CamInput_Changed"/></StackPanel>
                      <StackPanel Grid.Column="1"><TextBlock Text="Diameter" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CamChamferDiameter" Text="12.7" TextChanged="CamInput_Changed"/></StackPanel>
                      <StackPanel Grid.Column="2"><TextBlock Text="Vinkel °" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CamChamferAngle" Text="90" TextChanged="CamInput_Changed"/></StackPanel>
                    </Grid>
                  </StackPanel>
                </StackPanel>
                <CheckBox x:Name="CamDogbones" Content="Dogbones i innerhörn (för fogar)" Margin="4,10,4,0" Checked="CamInput_Changed" Unchecked="CamInput_Changed"
                          ToolTip="Ett runt urtag i varje skarpt innerhörn som fräsen inte når, så att en fyrkantig tapp eller del passar. Hålets hörn vid invändig kontur och ficka, delens innerhörn vid utvändig kontur."/>
                <CheckBox x:Name="CamTabs" IsChecked="True" Content="Hållflikar (vid genomskärning)" Margin="4,10,4,4" Checked="CamInput_Changed" Unchecked="CamInput_Changed"/>
                <Grid x:Name="TabSettingsPanel" Margin="18,0,0,2">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0"><TextBlock Text="Antal" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CamTabCount" Text="4" TextChanged="CamInput_Changed" ToolTip="Flikar per sluten bana. Färre placeras om banan är för kort."/></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock Text="Bredd mm" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CamTabWidth" Text="6" TextChanged="CamInput_Changed" ToolTip="Bredden på materialbryggan vid delen."/></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="Höjd mm" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CamTabHeight" Text="3" TextChanged="CamInput_Changed" ToolTip="Flikens höjd ovanför spårets botten."/></StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <!-- 3. Speeds -->
            <Border Style="{StaticResource CamCard}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Matning" Style="{StaticResource FieldLabel}" ToolTip="Skärande matning, mm/min (G1 F)"/><TextBox x:Name="CamFeed" Text="1000" TextChanged="CamInput_Changed" ToolTip="mm/min"/></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock Text="Nedmatning" Style="{StaticResource FieldLabel}" ToolTip="Matning nedåt i Z, mm/min"/><TextBox x:Name="CamPlunge" Text="300" TextChanged="CamInput_Changed" ToolTip="mm/min"/></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="Varvtal" Style="{StaticResource FieldLabel}" ToolTip="Spindelvarvtal, varv/min (M3 S)"/><TextBox x:Name="CamRpm" Text="18000" TextChanged="CamInput_Changed" ToolTip="varv/min"/></StackPanel>
                </Grid>
                <TextBlock Text="mm/min · mm/min · varv/min" Foreground="#8CA3BA" FontSize="10.5" Margin="3,1,3,0"/>
              </StackPanel>
            </Border>

            <!-- 4. Entry and direction (details) -->
            <Expander x:Name="CamAdvancedExpander" Header="AVANCERAT · nedmatning och fräsriktning" IsExpanded="False" Margin="0,0,0,10">
              <Border Style="{StaticResource CamCard}" Margin="0,4,0,0">
                <StackPanel>
                  <Grid x:Name="PlungeModePanel">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Nedmatning" Style="{StaticResource FieldLabel}"/>
                      <ComboBox x:Name="CamPlungeMode" SelectedIndex="0" Margin="3" SelectionChanged="CamInput_Changed">
                        <ComboBoxItem Content="Rak (lodrät)"/><ComboBoxItem Content="Rampad längs banan"/>
                      </ComboBox></StackPanel>
                    <StackPanel Grid.Column="1" x:Name="RampAnglePanel"><TextBlock Text="Vinkel °" Style="{StaticResource FieldLabel}"/>
                      <TextBox x:Name="CamRampAngle" Text="3" TextChanged="CamInput_Changed" ToolTip="Rampens vinkel mot horisontalplanet, 1–45°. 2–5° är skonsamt i trä."/></StackPanel>
                    <StackPanel Grid.Column="2" x:Name="RampFeedPanel"><TextBlock Text="Matning %" Style="{StaticResource FieldLabel}"/>
                      <TextBox x:Name="CamRampFeed" Text="70" TextChanged="CamInput_Changed" ToolTip="Matning längs rampen i % av matningen (5–100). Rampen skär med både spets och sida, så lägre fart är skonsammare."/></StackPanel>
                  </Grid>
                  <TextBlock Text="Fräsriktning" Style="{StaticResource FieldLabel}" Margin="3,6,3,0"/>
                  <ComboBox x:Name="CamDirectionPicker" SelectedIndex="0" Margin="3" SelectionChanged="CamInput_Changed"
                            ToolTip="Medfräsning (climb): väggen på fräsens högra sida, renare yta. Motfräsning (conventional): väggen till vänster, lugnare på svaga maskiner. Gäller medurs spindel (M3).">
                    <ComboBoxItem Content="Standard (som beräknad)"/><ComboBoxItem Content="Medfräsning (climb)"/><ComboBoxItem Content="Motfräsning (conventional)"/>
                  </ComboBox>
                </StackPanel>
              </Border>
            </Expander>

            <!-- Summary and save for this object -->
            <Border Background="#1A3A2C" BorderBrush="#2F6B4C" BorderThickness="1" Padding="10,8" CornerRadius="5" Margin="0,0,0,6">
              <TextBlock x:Name="CamSummary" Text="3 pass vid 2 mm/pass." TextWrapping="Wrap" Foreground="#D5E3F0"/>
            </Border>
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Button Content="Spara CAM" Background="#24618C" FontWeight="SemiBold" Click="SaveCam_Click" ToolTip="Spara inställningarna ovan på det markerade objektet"/>
              <Button Grid.Column="1" Content="Ta bort" Click="RemoveCam_Click" ToolTip="Ta bort det markerade objektets CAM"/>
            </Grid>
            </StackPanel>

            


          </StackPanel>
        </Border></ScrollViewer></DockPanel>
   </Border>
     </ad:LayoutAnchorable>
    </ad:LayoutAnchorablePane>
    </ad:LayoutAnchorablePaneGroup>
    <ad:LayoutAnchorablePane DockWidth="340">
     <ad:LayoutAnchorable ContentId="Machine" Title="Maskinstyrning" CanClose="False" CanHide="True" FloatingWidth="360" FloatingHeight="760">
 <Border x:Name="MachinePanel" Background="#17212C" BorderBrush="#50657D" BorderThickness="1,0,0,0">
    <DockPanel><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Border Padding="12,10"><StackPanel>
          <!-- Right column: state and work coordinate system, position with Zero / Go to per axis, then jogging. -->
          <DockPanel Margin="0,0,0,8">
            <ComboBox x:Name="WcsPicker" DockPanel.Dock="Right" Width="72" SelectedIndex="0" SelectionChanged="Wcs_Changed" ToolTip="Aktivt arbetskoordinatsystem (läses med $G)">
              <ComboBoxItem Content="G54"/><ComboBoxItem Content="G55"/><ComboBoxItem Content="G56"/>
              <ComboBoxItem Content="G57"/><ComboBoxItem Content="G58"/><ComboBoxItem Content="G59"/>
            </ComboBox>
            <TextBlock DockPanel.Dock="Right" Text="Koordinatsystem" Foreground="#8CA3BA" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <Border Background="#223243" CornerRadius="10" Padding="10,3" HorizontalAlignment="Left"><TextBlock x:Name="LiveStateText" Text="Ej ansluten" FontWeight="Bold"/></Border>
          </DockPanel>
          <UniformGrid Columns="2" Margin="0,0,0,6">
            <Button x:Name="HomeButton" Content="Homing ($H)" local:Ui.Icon="&#xE80F;" Click="Home_Click" Background="#2E7A4A" FontWeight="SemiBold" ToolTip="Kör homing: först Z upp mot brytaren, sedan X och Y mot sina brytare. Därefter är maskinkoordinaterna kända."/>
            <Button x:Name="ResetGrblButton" Content="Återställ (Ctrl-X)" local:Ui.Icon="&#xE777;" Click="ResetGrbl_Click" IsEnabled="False" Margin="3,2,3,0"
                  ToolTip="Mjuk återställning av GRBL. Behövs efter ett larm från en brytare (Reset to continue). Stoppar all rörelse; efter återställning under rörelse krävs homing."/>
          </UniformGrid>
          <StackPanel x:Name="MachineControls" IsEnabled="False">
            <Border Background="#10202E" CornerRadius="6" Padding="6,6" Margin="0,2,0,6">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="46"/><RowDefinition Height="46"/></Grid.RowDefinitions>
              <Button Grid.Row="0" Content="X0" Tag="X" Click="Zero_Click" Foreground="#FF6B6B" FontWeight="Bold" ToolTip="Nolla X: nuvarande X blir 0 i aktivt koordinatsystem (G10 L20 P0 X0)"/>
              <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0" VerticalAlignment="Center"><TextBlock x:Name="DroX" Text="–" FontSize="26" FontWeight="Bold" FontFamily="Consolas" Foreground="#7FB6F0" HorizontalAlignment="Center"/><TextBlock x:Name="MposX" Text="" FontSize="10.5" FontFamily="Consolas" Foreground="#8CA3BA" HorizontalAlignment="Center"/></StackPanel>
              <Button Grid.Row="0" Grid.Column="2" Content="X" Tag="X" Click="GoTo_Click" local:Ui.Icon="&#xE768;" ToolTip="Gå till X0 (Z lyfts först)"/>
              <Button Grid.Row="1" Content="Y0" Tag="Y" Click="Zero_Click" Foreground="#6BD38A" FontWeight="Bold" ToolTip="Nolla Y: nuvarande Y blir 0 i aktivt koordinatsystem (G10 L20 P0 Y0)"/>
              <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0" VerticalAlignment="Center"><TextBlock x:Name="DroY" Text="–" FontSize="26" FontWeight="Bold" FontFamily="Consolas" Foreground="#7FB6F0" HorizontalAlignment="Center"/><TextBlock x:Name="MposY" Text="" FontSize="10.5" FontFamily="Consolas" Foreground="#8CA3BA" HorizontalAlignment="Center"/></StackPanel>
              <Button Grid.Row="1" Grid.Column="2" Content="Y" Tag="Y" Click="GoTo_Click" local:Ui.Icon="&#xE768;" ToolTip="Gå till Y0 (Z lyfts först)"/>
              <Button Grid.Row="2" Content="Z0" Tag="Z" Click="Zero_Click" Foreground="#6FB4FF" FontWeight="Bold" ToolTip="Nolla Z: nuvarande Z blir 0 i aktivt koordinatsystem (G10 L20 P0 Z0)"/>
              <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0" VerticalAlignment="Center"><TextBlock x:Name="DroZ" Text="–" FontSize="26" FontWeight="Bold" FontFamily="Consolas" Foreground="#7FB6F0" HorizontalAlignment="Center"/><TextBlock x:Name="MposZ" Text="" FontSize="10.5" FontFamily="Consolas" Foreground="#8CA3BA" HorizontalAlignment="Center"/></StackPanel>
              <Button Grid.Row="2" Grid.Column="2" Content="Z" Tag="Z" Click="GoTo_Click" local:Ui.Icon="&#xE768;" ToolTip="Gå till Z0 (Z lyfts först)"/>
            </Grid>
            </Border>
            <UniformGrid Columns="2">
              <DockPanel Margin="0">
                <Button x:Name="ZeroXyMenuButton" DockPanel.Dock="Right" Content="▾" Click="ZeroXyMenu_Click" Background="#24618C" Padding="6,6" Margin="0,3,3,3"
                        ToolTip="Fler sätt att nolla X och Y: här, eller vid materialet enligt placeringen i maskinvyn">
                  <Button.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Här – där fräsen står nu" Tag="XY" Click="Zero_Click" ToolTip="G10 L20 P0 X0 Y0. Z ändras inte."/>
                      <MenuItem Header="Vid materialet – enligt placeringen i maskinvyn…" Click="ZeroAtPlacement_Click"
                                ToolTip="X0 Y0 i materialets främre vänstra hörn (eller mitt) där det är ritat på bordet. Maskinen rör sig inte."/>
                    </ContextMenu>
                  </Button.ContextMenu>
                </Button>
                <Button Content="Nolla X + Y" Tag="XY" Click="Zero_Click" local:Ui.Icon="&#xE81D;" Background="#24618C" Margin="3,3,0,3" ToolTip="Nollar X och Y där fräsen står – Z ändras inte (G10 L20 P0 X0 Y0). Pilen ▾: nolla vid materialet i stället."/>
              </DockPanel>
              <Button Content="Gå till X0 Y0" Tag="XY" Click="GoTo_Click" local:Ui.Icon="&#xE707;" ToolTip="Lyfter Z till nära överkanten (G53) och går till X0 Y0"/>
            </UniformGrid>
            <TextBlock Text="Stora siffror = arbetskoordinater, små = maskinkoordinater (MPos)." FontSize="10.5" Foreground="#8CA3BA" Margin="3,2,3,8"/>
            <Grid HorizontalAlignment="Center">
              <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="54"/><ColumnDefinition Width="54"/><ColumnDefinition Width="18"/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="44"/><RowDefinition Height="44"/></Grid.RowDefinitions>
              <Button Grid.Column="1" Content="Y+" Tag="Y+" PreviewMouseLeftButtonDown="Jog_Down" PreviewMouseLeftButtonUp="Jog_Up" LostMouseCapture="Jog_Lost"/>
              <Button Content="↖" Tag="X-Y+" FontSize="16" Foreground="#B8CADC" PreviewMouseLeftButtonDown="Jog_Down" PreviewMouseLeftButtonUp="Jog_Up" LostMouseCapture="Jog_Lost" ToolTip="Diagonalt: X− och Y+ samtidigt. Klick = ett steg i båda, håll inne = kontinuerligt."/>
              <Button Grid.Column="2" Content="↗" Tag="X+Y+" FontSize="16" Foreground="#B8CADC" PreviewMouseLeftButtonDown="Jog_Down" PreviewMouseLeftButtonUp="Jog_Up" LostMouseCapture="Jog_Lost" ToolTip="Diagonalt: X+ och Y+ samtidigt. Klick = ett steg i båda, håll inne = kontinuerligt."/>
              <Button Grid.Row="2" Content="↙" Tag="X-Y-" FontSize="16" Foreground="#B8CADC" PreviewMouseLeftButtonDown="Jog_Down" PreviewMouseLeftButtonUp="Jog_Up" LostMouseCapture="Jog_Lost" ToolTip="Diagonalt: X− och Y− samtidigt. Klick = ett steg i båda, håll inne = kontinuerligt."/>
              <Button Grid.Row="2" Grid.Column="2" Content="↘" Tag="X+Y-" FontSize="16" Foreground="#B8CADC" PreviewMouseLeftButtonDown="Jog_Down" PreviewMouseLeftButtonUp="Jog_Up" LostMouseCapture="Jog_Lost" ToolTip="Diagonalt: X+ och Y− samtidigt. Klick = ett steg i båda, håll inne = kontinuerligt."/>
              <Button Grid.Row="1" Content="X−" Tag="X-" PreviewMouseLeftButtonDown="Jog_Down" PreviewMouseLeftButtonUp="Jog_Up" LostMouseCapture="Jog_Lost"/>
              <Button Grid.Row="1" Grid.Column="1" Content="STOPP" Click="JogStop_Click" Background="#8A2E26" FontWeight="Bold" FontSize="11" ToolTip="Avbryt joggen direkt (0x85)"/>
              <Button Grid.Row="1" Grid.Column="2" Content="X+" Tag="X+" PreviewMouseLeftButtonDown="Jog_Down" PreviewMouseLeftButtonUp="Jog_Up" LostMouseCapture="Jog_Lost"/>
              <Button Grid.Row="2" Grid.Column="1" Content="Y−" Tag="Y-" PreviewMouseLeftButtonDown="Jog_Down" PreviewMouseLeftButtonUp="Jog_Up" LostMouseCapture="Jog_Lost"/>
              <Button Grid.Column="4" Content="Z+" Tag="Z+" PreviewMouseLeftButtonDown="Jog_Down" PreviewMouseLeftButtonUp="Jog_Up" LostMouseCapture="Jog_Lost"/>
              <Button Grid.Row="2" Grid.Column="4" Content="Z−" Tag="Z-" PreviewMouseLeftButtonDown="Jog_Down" PreviewMouseLeftButtonUp="Jog_Up" LostMouseCapture="Jog_Lost"/>
            </Grid>
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="XY steg mm" FontSize="10.5"/><TextBox x:Name="JogStepXY" Text="5"/></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="Z steg mm" FontSize="10.5"/><TextBox x:Name="JogStepZ" Text="2"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="mm/min" FontSize="10.5"/><TextBox x:Name="JogFeed" Text="3000"/></StackPanel>
            </Grid>
              <StackPanel Grid.Column="2" VerticalAlignment="Center">
              <StackPanel Margin="0,0,0,0">
              <RadioButton x:Name="PresetPrecise" Margin="0,2" Content="Precis" GroupName="JogPreset" Foreground="#E8F1FA" Checked="JogPreset_Checked" Tag="0"/>
              <RadioButton x:Name="PresetNormal" Margin="0,2" Content="Normal" GroupName="JogPreset" Foreground="#E8F1FA" Checked="JogPreset_Checked" Tag="1" IsChecked="True"/>
              <RadioButton x:Name="PresetRapid" Margin="0,2" Content="Snabb" GroupName="JogPreset" Foreground="#E8F1FA" Checked="JogPreset_Checked" Tag="2"/>
            </StackPanel>
              </StackPanel>
            </Grid>
            <TextBlock Text="Klick = ett steg. Håll inne = kontinuerlig jogg – släpp för att stanna. Piltangenter och Page Up/Down fungerar också." TextWrapping="Wrap" FontSize="10.5" Foreground="#8CA3BA" Margin="3,6,3,2"/>
            <TextBlock x:Name="JogStatusText" Text="" TextWrapping="Wrap" FontSize="11" Foreground="#FFB38A" Margin="3,2"/>
          </StackPanel>
          <TextBlock x:Name="MachineControlsHint" Text="Anslut för att nolla och jogga." TextWrapping="Wrap" Foreground="#8CA3BA" FontSize="11" Margin="3,4"/>
        </StackPanel>
      </Border></ScrollViewer></DockPanel>
   </Border>
     </ad:LayoutAnchorable>
    </ad:LayoutAnchorablePane>
   </ad:LayoutPanel>
  </ad:LayoutRoot>
 </ad:DockingManager>
 </DockPanel>
</Window>
