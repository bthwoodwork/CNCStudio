nsterlayout" Click="ResetDockLayout_Click" ToolTip="Lägg tillbaka alla paneler där de var från början"/></MenuItem>
 <MenuItem Header="_Maskin"><MenuItem Header="Första test mot maskinen…" Click="FirstTest_Click"/><Separator/><MenuItem Header="Maskiner (per maskin: inställningar, $$-kopior, kalibrering)…" Click="Machines_Click"/><MenuItem Header="Maskininställningar…" Click="MachineSettings_Click"/><MenuItem Header="Maskininformation…" Click="MachineInfo_Click" ToolTip="Firmware, aktiva lägen ($G), ingångar live och låsning av stegmotorerna"/><MenuItem Header="Maskinlogg och underhåll…" Click="MachineLog_Click" ToolTip="Körda jobb, larm, körtid och underhåll för den valda maskinen"/><MenuItem Header="GRBL-konsol…" Click="OpenConsole_Click"/><MenuItem Header="Testa gränslägesbrytare…" Click="OpenLimitTest_Click"/><Separator/><MenuItem Header="Rita fastspänningsblock" Click="StartFixture_Click"/><MenuItem Header="Planfräsa offerskivan…" Click="Surfacing_Click" ToolTip="Fräs offerskivan plan med en bred fräs. Blir ett eget projekt."/><Separator/><MenuItem Header="Visa maskinpanelen" Click="ShowPanel_Click" Tag="Machine"/><Separator/><MenuItem Header="Probning…" Click="Probe_Click"/><MenuItem Header="Planhetskontroll…" Click="Flatness_Click" ToolTip="Proba 5 eller 9 punkter med plattan och se hur plant materialet är"/><MenuItem Header="Gamepad…" Click="GamepadSettings_Click"/><MenuItem Header="Styr från mobilen…" Click="Remote_Click" ToolTip="Jogga, stoppa, pausa och nolla från telefonen (samma wifi)"/><MenuItem Header="Tangentbord (jogga med tangenterna)…" Click="KeyboardSettings_Click"/><Separator/><MenuItem Header="Nolla X" Click="Zero_Click" Tag="X"/><MenuItem Header="Nolla Y" Click="Zero_Click" Tag="Y"/><MenuItem Header="Nolla Z" Click="Zero_Click" Tag="Z"/><MenuItem Header="Nolla X + Y, behåll Z" Click="Zero_Click" Tag="XY"/><MenuItem Header="Nolla X + Y vid materialet (enligt placeringen)…" Click="ZeroAtPlacement_Click"/><MenuItem Header="Gå till X0 Y0" Click="GoTo_Click" Tag="XY"/><MenuItem Header="Platser (fräsbyte, parkering …)…" Click="ManageLocations_Click"/><MenuItem x:Name="NotifySoundMenuItem" Header="Ljud vid klart, paus och larm" IsCheckable="True" IsChecked="True" Click="NotifySound_Click" ToolTip="Ljud på datorn när programmet är klart, väntar vid M0, stoppas eller maskinen får larm. Mobilsidan aviseras alltid."/><MenuItem Header="Fräsbyte…" Click="ToolChange_Click" ToolTip="Mellan programmen i ett jobb med flera fräsar: till fräsbytet, byt fräs, proba Z och starta nästa program"/><Separator/><MenuItem Header="Demomaskin: simulera strömavbrott" Click="SimulatePowerCut_Click"/></MenuItem>
 <MenuItem Header="_Hjälp"><MenuItem Header="Manual…" Click="Manual_Click" InputGestureText="Shift+F1"/><Separator/><MenuItem Header="Loggar och fellogg…" Click="ShowLogs_Click"/><Separator/><MenuItem Header="Om CNC Studio" Click="About_Click"/></MenuItem>
</Menu>
 
<Border DockPanel.Dock="Top" Background="#223243" Padding="6,3" BorderBrush="#33475C" BorderThickness="0,0,0,1">
 <Border.Resources>
  <!-- Flat icon button for the toolbar; icons from the Windows icon font Segoe MDL2 Assets. -->
  <Style x:Key="ToolIcon" TargetType="Button">
   <Setter Property="Width" Value="34"/><Setter Property="Height" Value="30"/><Setter Property="Margin" Value="1,0"/>
   <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="15"/>
   <Setter Property="Foreground" Value="#E8F1FA"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#34506B"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#24618C"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <!-- Workspace tab: Tag="Active" marks the current workspace. -->
  <Style x:Key="WorkspaceTab" TargetType="Button">
   <Setter Property="MinWidth" Value="82"/><Setter Property="Height" Value="30"/><Setter Property="Margin" Value="0"/>
   <Setter Property="Padding" Value="14,0"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Foreground" Value="#B5C8DD"/><Setter Property="Background" Value="#2A3B4E"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#4A6078" BorderThickness="1" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#34506B"/></Trigger>
       <Trigger Property="Tag" Value="Active">
        <Setter TargetName="Bd" Property="Background" Value="#2E7DD7"/>
        <Setter TargetName="Bd" Property="BorderBrush" Value="#7FB6F0"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="ToolSeparator" TargetType="Border">
   <Setter Property="Width" Value="1"/><Setter Property="Margin" Value="7,5"/><Setter Property="Background" Value="#4A6078"/>
  </Style>
 </Border.Resources>
 <DockPanel LastChildFill="True">
  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
   <TextBlock Text="Arbetsyta" Foreground="#8CA3BA" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
   <Button x:Name="DesignTab" Content="Design" Style="{StaticResource WorkspaceTab}" Click="DesignWorkspace_Click" ToolTip="Rita, och välj direkt hur varje form ska fräsas (F1)"/>
   <Button x:Name="CamTab" Content="CAM" Style="{StaticResource WorkspaceTab}" Click="CamWorkspace_Click" Visibility="Collapsed"/>
   <Button x:Name="MachineTab" Content="Maskin" Style="{StaticResource WorkspaceTab}" Click="MachineWorkspace_Click" ToolTip="Maskinbordet: materialplacering, fastspänningar och maskinstyrning"/>
  </StackPanel>
  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
   <!-- Connection: done once, so it lives up here, apart from the machine control. -->
   <Border x:Name="ConnectionBanner" Background="#533C34" CornerRadius="4" Padding="8,3" Margin="2,4,4,4" VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal">
     <TextBlock x:Name="ConnectionStateText" Text="EJ ANSLUTEN" FontWeight="Bold" Foreground="#FFD0A8" VerticalAlignment="Center"/>
     <TextBlock x:Name="ConnectionDetailText" Text="" FontSize="11" Foreground="#E8DCD0" Margin="8,0,0,0" MaxWidth="170" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
    </StackPanel>
   </Border>
   <ComboBox x:Name="MachinePicker" DisplayMemberPath="Name" SelectionChanged="MachinePicker_Changed" ToolTip="Vilken maskin du arbetar mot. Varje maskin har en egen profil – demomaskinen också. Ansluter du på en port väljs maskinen som senast använde den." Width="130" Margin="2,4" VerticalAlignment="Center"/>
   <Button Content="☰" Click="Machines_Click" ToolTip="Maskiner: lägg till, ändra och ta bort maskiner, $$-kopior och kalibrering per maskin" Padding="7,2" Margin="0,4,4,4"/>
   <ComboBox x:Name="PortPicker" ToolTip="COM-port för GRBL-kontrollern (115200 baud, 8-N-1)" Width="150" Margin="2,4" VerticalAlignment="Center"/>
   <Button Content="⟳" Click="RefreshPorts_Click" ToolTip="Uppdatera listan med COM-portar" Padding="7,2" Margin="0,4,4,4"/>
   <Button x:Name="ConnectButton" Content="Anslut" Click="Connect_Click" Background="#24618C" Padding="12,2" Margin="0,4" MinWidth="82"/>
   <Border Style="{StaticResource ToolSeparator}"/>
   <Button Style="{StaticResource ToolIcon}" Content="&#xE8A5;" Click="New_Click" ToolTip="Nytt projekt (Ctrl+N)"/>
   <Button Style="{StaticResource ToolIcon}" Content="&#xE8E5;" Click="Open_Click" ToolTip="Öppna projekt (Ctrl+O)"/>
   <Button Style="{StaticResource ToolIcon}" Content="&#xE74E;" Click="Save_Click" ToolTip="Spara (Ctrl+S)"/>
   <Border Style="{StaticResource ToolSeparator}"/>
   <Button Style="{StaticResource ToolIcon}" Content="&#xE7A7;" Click="Undo_Click" ToolTip="Ångra (Ctrl+Z)"/>
   <Button Style="{StaticResource ToolIcon}" Content="&#xE7A6;" Click="Redo_Click" ToolTip="Gör om (Ctrl+Y)"/>
   <Border Style="{StaticResource ToolSeparator}"/>
   <Button Style="{StaticResource ToolIcon}" Content="&#xE896;" Click="ImportVector_Click" ToolTip="Importera SVG / DXF (Ctrl+I)"/>
   <Border Style="{StaticResource ToolSeparator}"/>
   <Button Style="{StaticResource ToolIcon}" Content="&#xE740;" Click="Fit_Click" ToolTip="Anpassa till fönstret (F)"/>
   <Button Style="{StaticResource ToolIcon}" Content="1:1" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Click="ActualSize_Click" ToolTip="Zoom 100 %"/>
  </StackPanel>
 </DockPanel>
</Border>
 <StatusBar DockPanel.Dock="Bottom" Background="#223243" Foreground="#D1DCE8">
  <StatusBar.ItemsPanel><ItemsPanelTemplate><DockPanel LastChildFill="True"/></ItemsPanelTemplate></StatusBar.ItemsPanel>
  <StatusBarItem DockPanel.Dock="Right" Margin="0,0,8,0">
   <StackPanel Orientation="Horizontal">
    <Button x:Name="RemoteIndicator" Content="📱 Mobilen på" Visibility="Collapsed" Click="Remote_Click" Padding="6,0" Margin="0,0,12,0" Background="#2E7A4A" ToolTip="Styrning från mobilen är på – klicka för adress och PIN"/>
    <TextBlock x:Name="CursorText" Text="" Foreground="#E8F1FA" FontFamily="Consolas" Margin="0,0,16,0"/>
    <TextBlock x:Name="ZoomLabel" Text="Zoom 100 %" Foreground="#B5C8DD"/>
    <TextBlock Text="  ·  " Foreground="#6E8094"/>
    <TextBlock x:Name="GridStepLabel" Text="Rutnät: 1 mm" Foreground="#8FDDAD"/>
   </StackPanel>
  </StatusBarItem>
  <StatusBarItem><TextBlock x:Name="StatusText" Text="Arbetsyta Design" TextTrimming="CharacterEllipsis"/></StatusBarItem>
 </StatusBar>
 <ad:DockingManager x:Name="DockManager" AllowMixedOrientation="True" Background="#17212C">
  <ad:DockingManager.Theme><ad:Vs2013DarkTheme/></ad:DockingManager.Theme>
  <ad:LayoutRoot>
   <ad:LayoutPanel Orientation="Horizontal">
    <ad:LayoutAnchorablePane DockWidth="78">
     <ad:LayoutAnchorable ContentId="Tools" Title="Rita" CanClose="False" CanHide="True" FloatingWidth="96" FloatingHeight="760">
 <Border x:Name="ToolsPanel" Background="#1C2A39" BorderBrush="#3C5167" BorderThickness="0,0,1,0">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="4,6">
  <StackPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Margin" Value="0,2"/><Setter Property="MinHeight" Value="50"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style></StackPanel.Resources>
  <Button x:Name="SelectToolButton" Content="Markera" local:Ui.Icon="&#xE7C9;" local:Ui.Rail="True" Click="SelectTool_Click" ToolTip="Markera och flytta (Esc)"/>
  <Button x:Name="RectangleToolButton" Content="Rektangel" local:Ui.Icon="&#xE739;" local:Ui.Rail="True" Click="RectangleTool_Click"/>
  <Button x:Name="EllipseToolButton" Content="Ellips" local:Ui.Icon="&#xEA3A;" local:Ui.Rail="True" Click="EllipseTool_Click"/>
  <Button x:Name="PolylineToolButton" Content="Linje" local:Ui.Icon="&#xE70F;" local:Ui.Rail="True" Click="PolylineTool_Click" ToolTip="Polylinje: klicka punkter, Enter = sluten, högerklick = öppen"/>
  <Button x:Name="TextToolButton" Content="Text" local:Ui.Icon="&#xE8D2;" local:Ui.Rail="True" Click="TextTool_Click" ToolTip="Text med valfritt typsnitt. Dubbelklicka på en text för att ändra den."/>
  <Button Content="Figurer" local:Ui.Icon="&#xE734;" local:Ui.Rail="True" Click="Figure_Click" ToolTip="Figurbank: stjärna, polygon, hjärta, pil, ring, rundad rektangel"/>
  <Button Content="Låda" local:Ui.Icon="&#xE7B8;" local:Ui.Rail="True" Click="Box_Click" ToolTip="Låda med fingerskarvar: fyra sidor och en botten, utlagda med utskärning, hållflikar och dogbones"/>
  <Button Content="Bild" local:Ui.Icon="&#xEB9F;" local:Ui.Rail="True" Click="ImageTrace_Click" ToolTip="Bild till vektor: logotyp, teckning eller silhuett blir en form"/>
  <Button Content="3D" local:Ui.Icon="&#xE81E;" local:Ui.Rail="True" Click="ImportStl_Click" ToolTip="3D-modell från STL – fräses i rader"/>
  <Button Content="Importera" local:Ui.Icon="&#xE896;" local:Ui.Rail="True" Click="ImportVector_Click" ToolTip="Importera SVG / DXF (Ctrl+I)"/>
  <Button x:Name="SnapButton" Content="Snap på" local:Ui.Icon="&#xE879;" local:Ui.Rail="True" Click="ToggleSnap_Click" ToolTip="Snappning till hörn, ändpunkter och rutnät – klicka för att slå av eller på"/>
  <Border Height="1" Background="#3C5167" Margin="6,6"/>
  <Button Content="Kombinera" local:Ui.Icon="&#xE71B;" local:Ui.Rail="True" Click="RailMenu_Click" ToolTip="Förena, subtrahera, skärning, XOR – för flera markerade former">
   <Button.ContextMenu><ContextMenu>
    <MenuItem Header="Förena" Click="Union_Click"/><MenuItem Header="Subtrahera" Click="Difference_Click"/><MenuItem Header="Skärning" Click="Intersection_Click"/><MenuItem Header="XOR" Click="Xor_Click"/>
    <Separator/><MenuItem Header="Kontrollera vektorer" Click="VectorCheck_Click"/>
   </ContextMenu></Button.ContextMenu>
  </Button>
