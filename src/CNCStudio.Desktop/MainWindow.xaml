<Window x:Class="CNCStudio.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:CNCStudio.Desktop"
 Title="CNC Studio 0.8.5 – verktygs- och materialbibliotek" Width="1500" Height="930" MinWidth="1060" MinHeight="650"
 KeyDown="Window_KeyDown" Loaded="Window_Loaded" Closing="MainWindow_Closing"
 Background="#17212C" Foreground="#E8F1FA">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="8,6"/><Setter Property="Background" Value="#34475A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#506783"/></Style>
  <Style TargetType="TextBox"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="5"/><Setter Property="Foreground" Value="#152332"/><Setter Property="Background" Value="#F5F8FB"/></Style>
  <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <!-- Dark menus: one template for top-level headers and dropdown items. -->
  <SolidColorBrush x:Key="MenuBg" Color="#26384D"/>
  <SolidColorBrush x:Key="MenuDropBg" Color="#1F2E3F"/>
  <SolidColorBrush x:Key="MenuHover" Color="#2E7DD7"/>
  <Style TargetType="MenuItem">
   <Setter Property="Foreground" Value="#E8F1FA"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="MenuItem">
      <Border x:Name="Bd" Background="Transparent" Padding="10,5" SnapsToDevicePixels="True">
       <Grid>
        <Grid.ColumnDefinitions>
         <ColumnDefinition x:Name="CheckCol" Width="22"/>
         <ColumnDefinition Width="*"/>
         <ColumnDefinition x:Name="GestureCol" Width="Auto"/>
         <ColumnDefinition x:Name="ArrowCol" Width="14"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Visibility="Collapsed"/>
        <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
        <TextBlock x:Name="Gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="28,0,0,0" Foreground="#8CA3BA" VerticalAlignment="Center"/>
        <TextBlock x:Name="Arrow" Grid.Column="3" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
               AllowsTransparency="True" Focusable="False" PopupAnimation="None">
         <Border Background="{StaticResource MenuDropBg}" BorderBrush="#4A6078" BorderThickness="1" Padding="0,4" MinWidth="200">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></ScrollViewer>
         </Border>
        </Popup>
       </Grid>
      </Border>
      <ControlTemplate.Triggers>
       <!-- Top level: just the header text, no check/gesture/arrow columns. -->
       <Trigger Property="Role" Value="TopLevelHeader">
        <Setter TargetName="CheckCol" Property="Width" Value="0"/>
        <Setter TargetName="GestureCol" Property="Width" Value="0"/>
        <Setter TargetName="ArrowCol" Property="Width" Value="0"/>
        <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed"/>
       </Trigger>
       <Trigger Property="Role" Value="SubmenuHeader">
        <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
        <Setter TargetName="PART_Popup" Property="Placement" Value="Right"/>
       </Trigger>
       <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
       <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource MenuHover}"/><Setter TargetName="Gesture" Property="Foreground" Value="#DCEBFA"/></Trigger>
       <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="Bd" Property="Background" Value="#34506B"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#6E8094"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="Separator" x:Key="{x:Static MenuItem.SeparatorStyleKey}">
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Margin="10,4" Background="#3C5167"/></ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <!-- Folding sections in panels: readable header and content on the dark background. -->
  <Style TargetType="Expander">
   <Setter Property="Foreground" Value="#E8F1FA"/>
   <Setter Property="HeaderTemplate">
    <Setter.Value>
     <DataTemplate><TextBlock Text="{Binding}" FontWeight="Bold" FontSize="12" Foreground="#A5C0D9" TextTrimming="CharacterEllipsis"/></DataTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <DockPanel>
 
<Menu DockPanel.Dock="Top" Background="#26384D" Foreground="#F4F7FB" Padding="5,3" FontSize="13">
 <MenuItem Header="_Arkiv"><MenuItem Header="Nytt" Click="New_Click" InputGestureText="Ctrl+N"/><MenuItem Header="Öppna..." Click="Open_Click" InputGestureText="Ctrl+O"/><Separator/><MenuItem Header="Spara" Click="Save_Click" InputGestureText="Ctrl+S"/><MenuItem Header="Spara som..." Click="SaveAs_Click" InputGestureText="Ctrl+Shift+S"/><Separator/><MenuItem Header="Importera SVG / DXF..." Click="ImportVector_Click" InputGestureText="Ctrl+I"/><Separator/><MenuItem Header="Synkmapp (Google Drive)…" Click="SyncFolder_Click"/><Separator/><MenuItem Header="Avsluta" Click="Exit_Click"/></MenuItem>
 <MenuItem Header="_Redigera"><MenuItem Header="Ångra" Click="Undo_Click" InputGestureText="Ctrl+Z"/><MenuItem Header="Gör om" Click="Redo_Click" InputGestureText="Ctrl+Y"/><Separator/><MenuItem Header="Markera alla" Click="SelectAll_Click" InputGestureText="Ctrl+A"/><MenuItem Header="Gruppera" Click="Group_Click" InputGestureText="Ctrl+G"/><MenuItem Header="Avgruppera" Click="Ungroup_Click" InputGestureText="Ctrl+Shift+G"/><Separator/><MenuItem Header="Duplicera" Click="Duplicate_Click" InputGestureText="Ctrl+D"/><MenuItem Header="Ta bort markerat" Click="Delete_Click" InputGestureText="Delete"/></MenuItem>
 <MenuItem Header="_Rita"><MenuItem Header="Markera / flytta" Click="SelectTool_Click"/><MenuItem Header="Rektangel" Click="RectangleTool_Click"/><MenuItem Header="Ellips" Click="EllipseTool_Click"/><MenuItem Header="Polylinje" Click="PolylineTool_Click"/><Separator/><MenuItem Header="Stäng polylinje" Click="ClosePolyline_Click"/><MenuItem Header="Snappning på/av" Click="ToggleSnap_Click"/></MenuItem>
 <MenuItem Header="_Objekt"><MenuItem Header="Förena" Click="Union_Click"/><MenuItem Header="Subtrahera" Click="Difference_Click"/><MenuItem Header="Skärning" Click="Intersection_Click"/><MenuItem Header="XOR" Click="Xor_Click"/><Separator/><MenuItem Header="Kontrollera vektorer" Click="VectorCheck_Click"/></MenuItem>
 <MenuItem Header="_CAM"><MenuItem Header="Exportera G-code…" Click="ExportGCode_Click" InputGestureText="Ctrl+E"/><Separator/><MenuItem Header="Verktygsbibliotek…" Click="ManageTools_Click"/><MenuItem Header="Materialbibliotek…" Click="ManageMaterials_Click"/><Separator/><MenuItem Header="V-carve inlay-inställningar" Click="OpenInlay_Click"/><Separator/><MenuItem Header="Visa CAM-panel" Click="ShowPanel_Click" Tag="Cam"/><MenuItem Header="Beräkna körbanor" Click="PreviewContour_Click"/><MenuItem Header="Visa/dölj XY-konturer (ej G-code)" Click="ToggleContourPreview_Click"/><MenuItem Header="Kontrollera fastspänningar (endast XY)" Click="ReviewCamSafety_Click"/><MenuItem Header="CAM-inställningar för markerat objekt" Click="ShowPanel_Click" Tag="Cam"/></MenuItem>
 <MenuItem Header="_Visa"><MenuItem x:Name="DesignMenuItem" Header="Arbetsyta: Design" Click="DesignWorkspace_Click" InputGestureText="F1"/><MenuItem x:Name="CamMenuItem" Header="Arbetsyta: CAM" Click="CamWorkspace_Click" InputGestureText="F2"/><MenuItem x:Name="MachineMenuItem" Header="Arbetsyta: Maskin" Click="MachineWorkspace_Click" InputGestureText="F3"/><Separator/><MenuItem x:Name="View3DMenuItem" Header="3D-vy" Click="Toggle3D_Click" InputGestureText="F4"/><Separator/><MenuItem Header="Anpassa material" Click="Fit_Click" InputGestureText="F"/><MenuItem Header="Zoom 100 %" Click="ActualSize_Click"/><Separator/><MenuItem Header="Visa ritverktyg" Click="ShowPanel_Click" Tag="Tools"/><MenuItem Header="Visa egenskaper" Click="ShowPanel_Click" Tag="Properties"/><MenuItem Header="Visa CAM-panel" Click="ShowPanel_Click" Tag="Cam"/><MenuItem Header="Visa maskinkontroll" Click="ShowPanel_Click" Tag="Machine"/></MenuItem>
 <MenuItem Header="_Maskin"><MenuItem Header="Första test mot maskinen…" Click="FirstTest_Click"/><Separator/><MenuItem Header="Maskininställningar…" Click="MachineSettings_Click"/><MenuItem Header="GRBL-konsol…" Click="OpenConsole_Click"/><MenuItem Header="Testa gränslägesbrytare…" Click="OpenLimitTest_Click"/><Separator/><MenuItem Header="Rita fastspänningsblock" Click="StartFixture_Click"/><Separator/><MenuItem Header="Visa maskinpanelen" Click="ShowPanel_Click" Tag="Machine"/><Separator/><MenuItem Header="Nolla X" Click="Zero_Click" Tag="X"/><MenuItem Header="Nolla Y" Click="Zero_Click" Tag="Y"/><MenuItem Header="Nolla Z" Click="Zero_Click" Tag="Z"/><MenuItem Header="Nolla X + Y, behåll Z" Click="Zero_Click" Tag="XY"/><MenuItem Header="Gå till X0 Y0" Click="GoTo_Click" Tag="XY"/><Separator/><MenuItem Header="Demomaskin: simulera strömavbrott" Click="SimulatePowerCut_Click"/></MenuItem>
 <MenuItem Header="_Hjälp"><MenuItem Header="Loggar och fellogg…" Click="ShowLogs_Click"/><Separator/><MenuItem Header="Om CNC Studio" Click="About_Click"/></MenuItem>
</Menu>
 
<Border DockPanel.Dock="Top" Background="#223243" Padding="6,3" BorderBrush="#33475C" BorderThickness="0,0,0,1">
 <Border.Resources>
  <!-- Flat icon button for the toolbar; icons from the Windows icon font Segoe MDL2 Assets. -->
  <Style x:Key="ToolIcon" TargetType="Button">
   <Setter Property="Width" Value="34"/><Setter Property="Height" Value="30"/><Setter Property="Margin" Value="1,0"/>
   <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="15"/>
   <Setter Property="Foreground" Value="#E8F1FA"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#34506B"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#24618C"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <!-- Workspace tab: Tag="Active" marks the current workspace. -->
  <Style x:Key="WorkspaceTab" TargetType="Button">
   <Setter Property="MinWidth" Value="82"/><Setter Property="Height" Value="30"/><Setter Property="Margin" Value="0"/>
   <Setter Property="Padding" Value="14,0"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Foreground" Value="#B5C8DD"/><Setter Property="Background" Value="#2A3B4E"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#4A6078" BorderThickness="1" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#34506B"/></Trigger>
       <Trigger Property="Tag" Value="Active">
        <Setter TargetName="Bd" Property="Background" Value="#2E7DD7"/>
        <Setter TargetName="Bd" Property="BorderBrush" Value="#7FB6F0"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="ToolSeparator" TargetType="Border">
   <Setter Property="Width" Value="1"/><Setter Property="Margin" Value="7,5"/><Setter Property="Background" Value="#4A6078"/>
  </Style>
 </Border.Resources>
 <DockPanel LastChildFill="True">
  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
   <TextBlock Text="Arbetsyta" Foreground="#8CA3BA" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
   <Button x:Name="DesignTab" Content="Design" Style="{StaticResource WorkspaceTab}" Click="DesignWorkspace_Click" ToolTip="Rita och redigera designen på materialet"/>
   <Button x:Name="CamTab" Content="CAM" Style="{StaticResource WorkspaceTab}" Click="CamWorkspace_Click" ToolTip="Bearbetning och körbanor på materialet"/>
   <Button x:Name="MachineTab" Content="Maskin" Style="{StaticResource WorkspaceTab}" Click="MachineWorkspace_Click" ToolTip="Maskinbordet: materialplacering, fastspänningar och maskinstyrning"/>
  </StackPanel>
  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
   <Button Style="{StaticResource ToolIcon}" Content="&#xE8A5;" Click="New_Click" ToolTip="Nytt projekt (Ctrl+N)"/>
   <Button Style="{StaticResource ToolIcon}" Content="&#xE8E5;" Click="Open_Click" ToolTip="Öppna projekt (Ctrl+O)"/>
   <Button Style="{StaticResource ToolIcon}" Content="&#xE74E;" Click="Save_Click" ToolTip="Spara (Ctrl+S)"/>
   <Border Style="{StaticResource ToolSeparator}"/>
   <Button Style="{StaticResource ToolIcon}" Content="&#xE7A7;" Click="Undo_Click" ToolTip="Ångra (Ctrl+Z)"/>
   <Button Style="{StaticResource ToolIcon}" Content="&#xE7A6;" Click="Redo_Click" ToolTip="Gör om (Ctrl+Y)"/>
   <Border Style="{StaticResource ToolSeparator}"/>
   <Button Style="{StaticResource ToolIcon}" Content="&#xE896;" Click="ImportVector_Click" ToolTip="Importera SVG / DXF (Ctrl+I)"/>
   <Border Style="{StaticResource ToolSeparator}"/>
   <Button Style="{StaticResource ToolIcon}" Content="&#xE740;" Click="Fit_Click" ToolTip="Anpassa till fönstret (F)"/>
   <Button Style="{StaticResource ToolIcon}" Content="1:1" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Click="ActualSize_Click" ToolTip="Zoom 100 %"/>
  </StackPanel>
 </DockPanel>
</Border>
 <StatusBar DockPanel.Dock="Bottom" Background="#223243" Foreground="#D1DCE8">
  <StatusBar.ItemsPanel><ItemsPanelTemplate><DockPanel LastChildFill="True"/></ItemsPanelTemplate></StatusBar.ItemsPanel>
  <StatusBarItem DockPanel.Dock="Right" Margin="0,0,8,0">
   <StackPanel Orientation="Horizontal">
    <TextBlock x:Name="CursorText" Text="" Foreground="#E8F1FA" FontFamily="Consolas" Margin="0,0,16,0"/>
    <TextBlock x:Name="ZoomLabel" Text="Zoom 100 %" Foreground="#B5C8DD"/>
    <TextBlock Text="  ·  " Foreground="#6E8094"/>
    <TextBlock x:Name="GridStepLabel" Text="Rutnät: 1 mm" Foreground="#8FDDAD"/>
   </StackPanel>
  </StatusBarItem>
  <StatusBarItem><TextBlock x:Name="StatusText" Text="Arbetsyta Design" TextTrimming="CharacterEllipsis"/></StatusBarItem>
 </StatusBar>
 <Grid x:Name="LayoutGrid">
 <Grid.ColumnDefinitions>
 <ColumnDefinition x:Name="ToolsColumn" Width="144"/><ColumnDefinition x:Name="ToolsSplitterColumn" Width="5"/>
 <ColumnDefinition Width="*"/>
 <ColumnDefinition x:Name="PropertiesSplitterColumn" Width="5"/><ColumnDefinition x:Name="PropertiesColumn" Width="250"/>
 <ColumnDefinition x:Name="MachineSplitterColumn" Width="5"/><ColumnDefinition x:Name="MachineColumn" Width="300"/>
 <ColumnDefinition x:Name="CamSplitterColumn" Width="0"/><ColumnDefinition x:Name="CamColumn" Width="0"/>
 </Grid.ColumnDefinitions>
 <Border x:Name="ToolsPanel" Grid.Column="0" Background="#243447" BorderBrush="#50657D" BorderThickness="0,0,1,0">
    <DockPanel><Border DockPanel.Dock="Top" Background="#30465C" Padding="8,5">
 <DockPanel LastChildFill="True">
  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
   <Button Content="↗" Tag="Tools" Click="FloatPanel_Click" Padding="3,1" Margin="1" ToolTip="Lossa panel som eget fönster"/>
   <Button Content="×" Tag="Tools" Click="HidePanel_Click" Padding="4,1" Margin="1" ToolTip="Dölj panel"/>
  </StackPanel><TextBlock Text="RITVERKTYG" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="Ritverktyg"/>
 </DockPanel></Border><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Border Padding="10"><StackPanel>
 <TextBlock Text="RITA" FontSize="11" FontWeight="Bold" Foreground="#A5C0D9" Margin="0,5,0,7"/>
 <Button x:Name="SelectToolButton" Content="Markera" Click="SelectTool_Click" ToolTip="Markera objekt direkt med vänsterklick"/>
 <Button x:Name="RectangleToolButton" Content="Rektangel" Click="RectangleTool_Click"/>
 <Button x:Name="EllipseToolButton" Content="Ellips" Click="EllipseTool_Click"/>
 <Button x:Name="PolylineToolButton" Content="Polylinje" Click="PolylineTool_Click"/>
 <Button Content="Stäng linje" Click="ClosePolyline_Click"/>
 <Separator Margin="0,9"/>
 <Button x:Name="SnapButton" Content="Snap: På" Click="ToggleSnap_Click"/>
 <TextBlock Text="OBJEKT" FontSize="11" FontWeight="Bold" Foreground="#A5C0D9" Margin="0,14,0,7"/>
 <Button Content="Förena" Click="Union_Click"/>
 <Button Content="Subtrahera" Click="Difference_Click"/>
 <Button Content="Skärning" Click="Intersection_Click"/>
 <Button Content="XOR" Click="Xor_Click"/>
 <Button Content="Vektorkoll" Click="VectorCheck_Click"/>
 <Separator Margin="0,9"/>
 <Button Content="Duplicera" Click="Duplicate_Click"/>
 <Button Content="Ta bort" Click="Delete_Click"/>
 </StackPanel></Border></ScrollViewer></DockPanel>
   </Border>
 <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#465D75" ResizeBehavior="PreviousAndNext"/>
 <Grid Grid.Column="2" Background="#101B27" ClipToBounds="True">
  <Canvas x:Name="Viewport" Background="#101B27" ClipToBounds="True" SizeChanged="Viewport_SizeChanged" MouseWheel="Viewport_Wheel" MouseMove="Viewport_MouseMove" MouseDown="Viewport_MouseDown" MouseUp="Viewport_MouseUp">
   <Canvas x:Name="DesignCanvas" Width="600" Height="600" Background="#1B2734" MouseLeftButtonDown="Canvas_Down" MouseRightButtonDown="Canvas_RightDown" MouseMove="Canvas_Move" MouseLeftButtonUp="Canvas_Up">
    <Canvas.RenderTransform><TransformGroup><ScaleTransform x:Name="DesignScale" ScaleX="1" ScaleY="1"/><TranslateTransform x:Name="DesignOffset"/></TransformGroup></Canvas.RenderTransform>
   </Canvas>
   <Canvas x:Name="MachineCanvas" Visibility="Collapsed" Background="#15202C"
           MouseLeftButtonDown="Machine_Down" MouseMove="Machine_Move" MouseLeftButtonUp="Machine_Up">
    <Canvas.RenderTransform><TransformGroup><ScaleTransform x:Name="MachineScale" ScaleX="1" ScaleY="1"/><TranslateTransform x:Name="MachineOffset"/></TransformGroup></Canvas.RenderTransform>
   </Canvas>
  </Canvas>
  <!-- Screen-space rulers do not scale with the material; they follow its transform. -->
  <Canvas x:Name="TopRuler" Height="30" VerticalAlignment="Top" Background="#283C50" IsHitTestVisible="False" ClipToBounds="True" Panel.ZIndex="10"/>
  <Canvas x:Name="LeftRuler" Width="38" HorizontalAlignment="Left" Background="#283C50" IsHitTestVisible="False" ClipToBounds="True" Panel.ZIndex="10"/>
  <Border x:Name="RulerCorner" Background="#283C50" Width="38" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Panel.ZIndex="11">
   <TextBlock Text="mm" FontSize="10" FontWeight="SemiBold" Foreground="#DAE8F5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
  </Border>
  <local:View3DPanel x:Name="View3DPanel" Visibility="Collapsed" Panel.ZIndex="20"/>
  <Button x:Name="View3DToggle" Content="3D" Click="Toggle3D_Click" Panel.ZIndex="30" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,40,14,0" Width="56" Height="46" FontSize="16" FontWeight="Bold" Background="#2E7DD7" Foreground="White" BorderBrush="#7FB6F0" ToolTip="Växla mellan 2D-ritning och 3D-vy (F4)"/>
  <Border Background="#26394D" CornerRadius="4" Padding="9,5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="50,0,0,12" IsHitTestVisible="False"><TextBlock Text="Hjul: zoom  |  Mittenknapp: panorera  |  Ctrl+klick: flermarkera  |  Ctrl+Z/Y: ångra/gör om" Foreground="#D7E7F5" FontSize="12"/></Border>
 </Grid>
 <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#465D75" ResizeBehavior="PreviousAndNext"/>
 <Border x:Name="PropertiesPanel" Grid.Column="4" Background="#243447" BorderBrush="#50657D" BorderThickness="0,0,1,0">
    <DockPanel><Border DockPanel.Dock="Top" Background="#30465C" Padding="8,5">
 <DockPanel LastChildFill="True">
  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
   <Button Content="↗" Tag="Properties" Click="FloatPanel_Click" Padding="5,2" Margin="2" ToolTip="Lossa panel som eget fönster"/>
   <Button Content="×" Tag="Properties" Click="HidePanel_Click" Padding="6,2" Margin="2" ToolTip="Dölj panel"/>
  </StackPanel><TextBlock x:Name="PropertiesTitle" Text="EGENSKAPER" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
 </DockPanel></Border><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Border Padding="10"><StackPanel>

         <!-- Design workspace: what you work on first – the selected object – then project and material. -->
         <StackPanel x:Name="DesignSections">
          <Expander Header="MARKERAT OBJEKT" IsExpanded="True" Margin="0,0,0,3">
           <StackPanel>
            <TextBlock x:Name="SelectedLabel" Text="Inget objekt markerat" Margin="3,2,3,6" Foreground="#B8CADC"/>
            <Grid>
             <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
             <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
             <StackPanel><TextBlock Text="X (mm)"/><TextBox x:Name="XBox" LostKeyboardFocus="ObjectProperty_LostKeyboardFocus" KeyDown="ObjectProperty_KeyDown"/></StackPanel>
             <StackPanel Grid.Column="1"><TextBlock Text="Y (mm)"/><TextBox x:Name="YBox" LostKeyboardFocus="ObjectProperty_LostKeyboardFocus" KeyDown="ObjectProperty_KeyDown"/></StackPanel>
             <StackPanel Grid.Row="1"><TextBlock Text="Bredd (mm)"/><TextBox x:Name="WidthBox" LostKeyboardFocus="ObjectProperty_LostKeyboardFocus" KeyDown="ObjectProperty_KeyDown"/></StackPanel>
             <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="Höjd (mm)"/><TextBox x:Name="HeightBox" LostKeyboardFocus="ObjectProperty_LostKeyboardFocus" KeyDown="ObjectProperty_KeyDown"/></StackPanel>
            </Grid>
            <TextBlock Text="Ändringar gäller när du trycker Tab eller Enter." TextWrapping="Wrap" Foreground="#AFBDD0" FontSize="11" Margin="3,6"/>
           </StackPanel>
          </Expander>
          <Expander Header="PROJEKT OCH MATERIAL" IsExpanded="True" Margin="0,10,0,3">
           <StackPanel>
            <TextBlock Text="Projektnamn"/><TextBox x:Name="NameBox" Text="Nytt projekt"/>
            <Grid>
             <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
             <StackPanel><TextBlock Text="Bredd"/><TextBox x:Name="MaterialWidthBox" Text="600"/></StackPanel>
             <StackPanel Grid.Column="1"><TextBlock Text="Höjd"/><TextBox x:Name="MaterialHeightBox" Text="600"/></StackPanel>
             <StackPanel Grid.Column="2"><TextBlock Text="Tjocklek"/><TextBox x:Name="MaterialThicknessBox" Text="18"/></StackPanel>
            </Grid>
            <TextBlock Text="Materialets mått i mm." Foreground="#AFBDD0" FontSize="11" Margin="3,2"/>
            <TextBlock Text="Materialtyp" Margin="0,6,0,0"/>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Material…" Click="ManageMaterials_Click" Padding="8,3" ToolTip="Materialbibliotek: lägg upp material i kategorier"/>
              <ComboBox x:Name="MaterialPicker" Margin="3" DisplayMemberPath="DisplayName" SelectionChanged="Material_Changed"
                        ToolTip="Materialet bestämmer vilken skärdata fräsarna använder (från verktygsbiblioteket)."/>
            </DockPanel>
            <TextBlock Text="Nollpunkt X/Y (G54)" Margin="0,6,0,0"/>
            <ComboBox x:Name="WorkZeroPicker" SelectedIndex="0" Margin="3" SelectionChanged="WorkZero_Changed"
                      ToolTip="Var X0 Y0 sätts på materialet innan körning. Z0 är alltid materialets ovansida.">
              <ComboBoxItem Content="Främre vänstra hörnet"/><ComboBoxItem Content="Mitten av materialet"/>
            </ComboBox>
            <Button Content="Uppdatera material" Click="UpdateMaterial_Click" Margin="3,6"/>
           </StackPanel>
          </Expander>
         </StackPanel>

         <!-- Maskin workspace: the machine table. -->
         <StackPanel x:Name="MachineSections" Visibility="Collapsed">
          <Expander Header="FASTSPÄNNINGAR" IsExpanded="True" Margin="0,0,0,3">
           <StackPanel>
            <Button x:Name="DrawFixtureButton" Content="+ Rita fastspänning" Click="StartFixture_Click" Background="#96522A" Foreground="White"
                    ToolTip="Dra en rektangel på maskinbordet för att lägga till en fastspänning. Esc avbryter."/>
            <TextBlock Text="Vald fastspänning" Margin="0,8,0,0"/><TextBlock x:Name="FixtureSelectionLabel" Text="Ingen vald – klicka på en på bordet" Foreground="#B8CADC" Margin="3,0,3,4"/>
