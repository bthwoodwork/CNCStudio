              <Button Grid.Column="1" Content="Kontrollera hinder" Click="ReviewCamSafety_Click" Background="#80532B" ToolTip="Kontroll av skärande XY-konturer mot fastspänningar och maskinens XY-gränser; ej full säkerhetskontroll"/>
            </Grid>
            <CheckBox x:Name="ContourVisibilityCheck" Content="Visa körbanorna i vyerna" IsChecked="True" Checked="ContourVisibility_Changed" Unchecked="ContourVisibility_Changed" Margin="4,8" Foreground="#D4E8D8"/>
