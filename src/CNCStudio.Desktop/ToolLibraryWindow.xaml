<Window x:Class="CNCStudio.Desktop.ToolLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verktygsbibliotek" Width="1060" Height="760" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#17212C" Foreground="#E8F1FA">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="12,5"/><Setter Property="Background" Value="#34475A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#506783"/></Style>
    <Style TargetType="TextBox"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="5"/><Setter Property="Foreground" Value="#152332"/><Setter Property="Background" Value="#F5F8FB"/></Style>
    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="3,3,10,3"/></Style>
  </Window.Resources>
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Margin="3,0,3,8">
      <TextBlock Text="VERKTYGSBIBLIOTEK" FontSize="18" FontWeight="Bold" Margin="0,0,0,2"/>
      <TextBlock TextWrapping="Wrap" Foreground="#BDCEE0" Margin="0"
                 Text="Dina fräsar i kategorier. Varje fräs har standardvärden och kan ha egen skärdata per material. När du väljer fräs i CAM-panelen används skärdatan för projektets material, annars standardvärdena."/>
      <TextBlock x:Name="PathText" Foreground="#8CA3BA" FontSize="11" Margin="0,2,0,0"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="Spara" Background="#24618C" IsDefault="True" Click="Save_Click"/>
      <Button Content="Avbryt" IsCancel="True"/>
    </StackPanel>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <DockPanel>
        <UniformGrid DockPanel.Dock="Bottom" Columns="3">
          <Button Content="Ny" Click="New_Click"/>
          <Button Content="Kopiera" Click="Copy_Click"/>
          <Button Content="Ta bort" Click="Delete_Click"/>
        </UniformGrid>
        <ListBox x:Name="ToolList" DisplayMemberPath="Name" SelectionChanged="ToolList_SelectionChanged"
                 Background="#1C2A39" Foreground="#E8F1FA" BorderBrush="#50657D">
          <ListBox.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate><TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="#A5C0D9" Margin="4,8,4,2"/></DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ListBox.GroupStyle>
        </ListBox>
      </DockPanel>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Editor">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
          </Grid.RowDefinitions>
          <TextBlock Text="Namn"/><TextBox x:Name="NameBox" Grid.Column="1"/>
          <TextBlock Grid.Row="1" Text="Kategori"/>
          <ComboBox x:Name="CategoryBox" Grid.Row="1" Grid.Column="1" Margin="3" IsEditable="True"
                    ToolTip="Välj en kategori eller skriv en ny, t.ex. &quot;Raka fräsar&quot;, &quot;Kompressionsfräsar&quot;, &quot;Planfräsar&quot;"/>
          <TextBlock Grid.Row="2" Text="Typ"/>
          <ComboBox x:Name="KindBox" Grid.Row="2" Grid.Column="1" Margin="3" SelectionChanged="KindBox_SelectionChanged">
            <ComboBoxItem Content="Rak fräs (plan botten)"/><ComboBoxItem Content="Kulfräs"/><ComboBoxItem Content="V-fräs"/>
          </ComboBox>
          <TextBlock Grid.Row="3" Text="Diameter (mm)"/><TextBox x:Name="DiameterBox" Grid.Row="3" Grid.Column="1"/>
          <TextBlock Grid.Row="4" Text="Vinkel (grader)" x:Name="AngleLabel"/><TextBox x:Name="AngleBox" Grid.Row="4" Grid.Column="1" ToolTip="V-fräsens spetsvinkel, t.ex. 60 eller 90"/>
          <TextBlock Grid.Row="5" Text="Antal skär"/><TextBox x:Name="FlutesBox" Grid.Row="5" Grid.Column="1"/>
          <TextBlock Grid.Row="6" Text="Anteckning"/><TextBox x:Name="NotesBox" Grid.Row="6" Grid.Column="1"/>
        </Grid>

        <TextBlock Text="STANDARDVÄRDEN – när materialet saknar egen skärdata" FontWeight="Bold" FontSize="11" Foreground="#A5C0D9" Margin="3,12,3,2"/>
        <UniformGrid Columns="4">
          <StackPanel><TextBlock Text="Matning (mm/min)" FontSize="11"/><TextBox x:Name="FeedBox"/></StackPanel>
          <StackPanel><TextBlock Text="Nedmatning (mm/min)" FontSize="11"/><TextBox x:Name="PlungeBox"/></StackPanel>
          <StackPanel><TextBlock Text="Djup per pass (mm)" FontSize="11"/><TextBox x:Name="PassBox"/></StackPanel>
          <StackPanel><TextBlock Text="Varvtal (varv/min)" FontSize="11"/><TextBox x:Name="RpmBox"/></StackPanel>
        </UniformGrid>

        <TextBlock Text="SKÄRDATA PER MATERIAL" FontWeight="Bold" FontSize="11" Foreground="#A5C0D9" Margin="3,14,3,2"/>
        <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="#BDCEE0" Margin="3,0,3,4"
                   Text="Fyll i alla fyra värdena för de material du har provat fräsen i. Lämna raden tom för att använda standardvärdena. Materialen läggs upp i Materialbiblioteket."/>
        <DataGrid x:Name="CuttingGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                  HeadersVisibility="Column" Margin="3" FontSize="12" MinHeight="140"
                  Background="#F5F8FB" RowBackground="#F5F8FB" AlternatingRowBackground="#E7EEF5" Foreground="#152332">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Material" Binding="{Binding Material}" IsReadOnly="True" Width="*"/>
            <DataGridTextColumn Header="Matning" Binding="{Binding Feed, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
            <DataGridTextColumn Header="Nedmatning" Binding="{Binding Plunge, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
            <DataGridTextColumn Header="Djup/pass" Binding="{Binding Pass, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
            <DataGridTextColumn Header="Varvtal" Binding="{Binding Rpm, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
          </DataGrid.Columns>
        </DataGrid>
        <StackPanel Orientation="Horizontal">
          <Button Content="Fyll vald rad med standardvärden" Click="FillDefaults_Click" ToolTip="Kopierar standardvärdena till markerat material som utgångspunkt"/>
          <Button Content="Töm vald rad" Click="ClearRow_Click"/>
        </StackPanel>

        <Button Content="Uppdatera fräsen" HorizontalAlignment="Left" Margin="3,10,3,3" Click="Apply_Click" Background="#24618C"/>
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="#FFB38A" Margin="3,4,3,3"/>
      </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
