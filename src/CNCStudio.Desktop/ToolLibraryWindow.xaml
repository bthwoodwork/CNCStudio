<Window x:Class="CNCStudio.Desktop.ToolLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verktygsbibliotek – fräsar" Width="820" Height="560" MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#17212C" Foreground="#E8F1FA">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="12,5"/><Setter Property="Background" Value="#34475A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#506783"/></Style>
    <Style TargetType="TextBox"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="5"/><Setter Property="Foreground" Value="#152332"/><Setter Property="Background" Value="#F5F8FB"/></Style>
    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="3,3,10,3"/></Style>
  </Window.Resources>
  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#BDCEE0" Margin="3,0,3,8"
               Text="Fräsarna och deras standardvärden används i alla projekt. Värdena fylls i när du väljer fräs i CAM-panelen och kan ändras där per operation. Standardvärdena är försiktiga startvärden för trä – anpassa efter din maskin och ditt material."/>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="Spara" Background="#24618C" IsDefault="True" Click="Save_Click"/>
      <Button Content="Avbryt" IsCancel="True"/>
    </StackPanel>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <DockPanel>
        <UniformGrid DockPanel.Dock="Bottom" Columns="3">
          <Button Content="Ny" Click="New_Click"/>
          <Button Content="Kopiera" Click="Copy_Click"/>
          <Button Content="Ta bort" Click="Delete_Click"/>
        </UniformGrid>
        <ListBox x:Name="ToolList" DisplayMemberPath="Name" SelectionChanged="ToolList_SelectionChanged"
                 Background="#1C2A39" Foreground="#E8F1FA" BorderBrush="#50657D"/>
      </DockPanel>
      <StackPanel Grid.Column="2" x:Name="Editor">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
          </Grid.RowDefinitions>
          <TextBlock Text="Namn"/><TextBox x:Name="NameBox" Grid.Column="1"/>
          <TextBlock Grid.Row="1" Text="Typ"/>
          <ComboBox x:Name="KindBox" Grid.Row="1" Grid.Column="1" Margin="3" SelectionChanged="KindBox_SelectionChanged">
            <ComboBoxItem Content="Rak fräs (plan botten)"/><ComboBoxItem Content="Kulfräs"/><ComboBoxItem Content="V-fräs"/>
          </ComboBox>
          <TextBlock Grid.Row="2" Text="Diameter (mm)"/><TextBox x:Name="DiameterBox" Grid.Row="2" Grid.Column="1"/>
          <TextBlock Grid.Row="3" Text="Vinkel (grader)" x:Name="AngleLabel"/><TextBox x:Name="AngleBox" Grid.Row="3" Grid.Column="1" ToolTip="V-fräsens spetsvinkel, t.ex. 60 eller 90"/>
          <TextBlock Grid.Row="4" Text="Antal skär"/><TextBox x:Name="FlutesBox" Grid.Row="4" Grid.Column="1"/>
          <TextBlock Grid.Row="5" Text="Matning (mm/min)"/><TextBox x:Name="FeedBox" Grid.Row="5" Grid.Column="1"/>
          <TextBlock Grid.Row="6" Text="Nedmatning (mm/min)"/><TextBox x:Name="PlungeBox" Grid.Row="6" Grid.Column="1"/>
          <TextBlock Grid.Row="7" Text="Djup per pass (mm)"/><TextBox x:Name="PassBox" Grid.Row="7" Grid.Column="1"/>
          <TextBlock Grid.Row="8" Text="Varvtal (varv/min)"/><TextBox x:Name="RpmBox" Grid.Row="8" Grid.Column="1"/>
          <TextBlock Grid.Row="9" Text="Anteckning"/><TextBox x:Name="NotesBox" Grid.Row="9" Grid.Column="1"/>
        </Grid>
        <Button Content="Uppdatera fräsen" HorizontalAlignment="Left" Margin="173,8,3,3" Click="Apply_Click"/>
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="#FFB38A" Margin="173,4,3,3"/>
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
